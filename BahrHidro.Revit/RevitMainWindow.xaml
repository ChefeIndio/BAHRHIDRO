<Window x:Class="BahrHidro.Revit.RevitMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bahr Hidro BIM — Engenharia Hidráulica no Revit 2026"
        Height="760" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SuccessBtn">
            <Setter Property="Background" Value="#15803D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryBtn">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- CABEÇALHO -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BAHR HIDRO BIM" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text=" | Dimensionamento Hidrossanitário &amp; Pluvial — Revit 2026" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtElementoSelecionado" Text="Nenhuma rede selecionada" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"/>
                    <Button Content="Selecionar Rede no Modelo 3D" Style="{StaticResource PrimaryBtn}" Click="BtnSelecionar3D_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA DE STATUS INFERIOR -->
        <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="16,8" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="TxtStatusGeral" Text="Clique em 'Selecionar Rede no Modelo 3D' para ler a tubulação do Revit." FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCatalogoInfo" Text="Catálogo: carregando..." Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ABAS DO PLUGIN -->
        <TabControl Margin="12" Background="White" BorderBrush="#CBD5E1">

            <!-- ABA 1: REDE ÁGUA FRIA (BIM 3D) -->
            <TabItem Header="1. REDE ÁGUA FRIA (BIM 3D)">
                <DockPanel Margin="14">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Vel. Máx (m/s):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtVelMax" Text="3,00" Width="58" Margin="0,0,14,0"/>

                                <TextBlock Text="Pressão Mín. (mca):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtPressaoMin" Text="3,00" Width="58" Margin="0,0,14,0"/>

                                <TextBlock Text="Viscosidade (m²/s):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="TxtViscosidade" Text="0,000001003" Width="105"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCalcularRede" Content="1. Calcular Rede" Style="{StaticResource PrimaryBtn}" IsEnabled="False" Click="BtnCalcularRede_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnAplicarRevit" Content="2. Aplicar Diâmetros no Revit" Style="{StaticResource SuccessBtn}" IsEnabled="False" Click="BtnAplicarRevit_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnExportarExcel" Content="3. Exportar Excel (.xlsx)" Style="{StaticResource SecondaryBtn}" IsEnabled="False" Click="BtnExportarExcel_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cartões de Resumo (KPIs) -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="TRECHOS MAPEADOS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="KpiTrechos" Text="0 trechos / 0 nós" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="VAZÃO NA ORIGEM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="KpiVazaoTotal" Text="-- L/s" FontSize="15" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="PRESSÃO MÍNIMA DISPONÍVEL" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="KpiPressaoMin" Text="-- m.c.a." FontSize="15" FontWeight="Bold" Foreground="#15803D" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="MAIOR PERDA DE CARGA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="KpiPerdaMax" Text="-- m.c.a." FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Tabelas de Trechos e Nós -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Trechos Mapeados e Dimensionamento Comercial" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridTrechos" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Trecho" Binding="{Binding Trecho}" Width="62"/>
                                    <DataGridTextColumn Header="Ligação" Binding="{Binding Ligacao}" Width="*"/>
                                    <DataGridTextColumn Header="L (m)" Binding="{Binding Comprimento}" Width="56"/>
                                    <DataGridTextColumn Header="Q (L/s)" Binding="{Binding Vazao}" Width="65"/>
                                    <DataGridTextColumn Header="Ø Revit" Binding="{Binding DiametroAtual}" Width="68"/>
                                    <DataGridTextColumn Header="Ø Calc." Binding="{Binding DiametroCalculado}" Width="72" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="V (m/s)" Binding="{Binding Velocidade}" Width="62"/>
                                    <DataGridTextColumn Header="ΔH (mca)" Binding="{Binding PerdaCarga}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Nós e Pressões Disponíveis" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridNos" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nó" Binding="{Binding Nome}" Width="*"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="82"/>
                                    <DataGridTextColumn Header="Cota (m)" Binding="{Binding Cota}" Width="64"/>
                                    <DataGridTextColumn Header="Pressão (mca)" Binding="{Binding Pressao}" Width="90" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ABA 2: ÁGUAS PLUVIAIS (NBR 10844) -->
            <TabItem Header="2. ÁGUAS PLUVIAIS (NBR 10844)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="1. REGIÃO E PLUVIOMETRIA" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cidade / Região:" FontSize="12" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="CmbRegiao" Height="28" DisplayMemberPath="DisplayName" SelectionChanged="CmbRegiao_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Período Retorno (T):" FontSize="12" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="CmbPeriodoRetorno" Height="28" SelectedIndex="1" SelectionChanged="CmbPeriodoRetorno_SelectionChanged">
                                                <ComboBoxItem Content="1 ano (Pisos)" Tag="1"/>
                                                <ComboBoxItem Content="5 anos (Telhados)" Tag="5"/>
                                                <ComboBoxItem Content="25 anos (Crítico)" Tag="25"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Chuva I (mm/h):" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtIntensidade" Height="28" Text="148"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="2. COBERTURA E CALHA" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Comp. b (m):" FontSize="12"/>
                                            <TextBox x:Name="TxtLarguraTelhado" Text="10,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Projeção a (m):" FontSize="12"/>
                                            <TextBox x:Name="TxtProjecaoTelhado" Text="6,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Altura h (m):" FontSize="12"/>
                                            <TextBox x:Name="TxtAlturaTelhado" Text="1,5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Parede (m²):" FontSize="12"/>
                                            <TextBox x:Name="TxtParede" Text="0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.7*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Formato Calha:" FontSize="12"/>
                                            <ComboBox x:Name="CmbFormatoCalha" Height="28" SelectedIndex="0">
                                                <ComboBoxItem Content="Retangular" Tag="Rectangular"/>
                                                <ComboBoxItem Content="Semicircular" Tag="Semicircular"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Material:" FontSize="12"/>
                                            <ComboBox x:Name="CmbMaterialCalha" Height="28" SelectedIndex="0">
                                                <ComboBoxItem Content="PVC / Zinco (0,011)" Tag="PvcOrMetal"/>
                                                <ComboBoxItem Content="Concreto Liso (0,012)" Tag="CastIronOrSmoothConcrete"/>
                                                <ComboBoxItem Content="Cerâmica (0,013)" Tag="CeramicOrRoughConcrete"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Decliv. (%):" FontSize="12"/>
                                            <TextBox x:Name="TxtDeclividade" Text="0,5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Nº Descidas:" FontSize="12"/>
                                            <TextBox x:Name="TxtQtdDescidas" Text="1"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="Dimensionar Calhas e Condutores (NBR 10844)" Style="{StaticResource PrimaryBtn}" Click="BtnCalcularPluvial_Click"/>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="RESULTADO PLUVIAL" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A" Margin="0,0,0,12"/>
                                <TextBlock x:Name="LblPluvArea" Text="Área de Contribuição: -- m²" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LblPluvVazao" Text="Vazão de Projeto: -- L/min" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" Margin="0,0,0,12"/>
                                <Separator Margin="0,0,0,12"/>
                                <TextBlock x:Name="LblPluvCalha" Text="Calha Comercial: --" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LblPluvCapCalha" Text="Capacidade / Ocupação: --" Margin="0,0,0,12"/>
                                <Separator Margin="0,0,0,12"/>
                                <TextBlock x:Name="LblPluvCondutor" Text="Condutor Vertical: --" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LblPluvCapCondutor" Text="Vazão / Capacidade por tubo: --"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 3: DADOS DO PROJETO & CATÁLOGO -->
            <TabItem Header="3. DADOS DO PROJETO &amp; CATÁLOGO">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Informações da Obra (Sincronizadas com o Revit)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Nome do Empreendimento / Obra:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtObraNome" Text="Residencial Exemplo"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Proprietário / Cliente:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtClienteNome"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Endereço da Obra:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtObraEndereco"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Cidade / UF:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtObraCidade" Text="Ponta Grossa - PR"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Text="Responsável Técnico (Engenheiro):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEngenheiroNome"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Text="Registro Profissional (CREA / CAU):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtEngenheiroCrea"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Salvar Dados no Project Information do Revit" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnSalvarProjectInfo_Click"/>
                    </StackPanel>

                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Bitolas Comerciais Ativas para Dimensionamento" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <DataGrid x:Name="GridCatalogo" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="25">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Bitola / Linha Comercial" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Ø Interno (mm)" Binding="{Binding InternalDiameterMm}" Width="115" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
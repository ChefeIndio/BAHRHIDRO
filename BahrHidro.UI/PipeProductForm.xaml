<Window x:Class="BahrHidro.UI.PipeProductForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bahr Hidro - Cadastro de Tubulação"
        Height="760"
        Width="850"
        MinHeight="650"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#17365D"
                Padding="25">

            <StackPanel>
                <TextBlock Text="BAHR HIDRO"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Cadastro de produto hidráulico"
                           FontSize="13"
                           Foreground="#D6E2F0"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- FORMULÁRIO -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25">

                <TextBlock Text="Identificação do produto"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#17365D"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                        <TextBlock Text="Fabricante"/>
                        <TextBox x:Name="ManufacturerBox" Height="34" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                        <TextBlock Text="Linha comercial"/>
                        <TextBox x:Name="ProductLineBox" Height="34" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                        <TextBlock Text="Material"/>
                        <ComboBox x:Name="MaterialBox"
                                  Height="34"
                                  Margin="0,5,0,0"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="PVC Soldável"/>
                            <ComboBoxItem Content="PVC Roscável"/>
                            <ComboBoxItem Content="PPR"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                        <TextBlock Text="Designação nominal"/>
                        <TextBox x:Name="NominalDesignationBox"
                                 Height="34"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,15">
                        <TextBlock Text="Classe de pressão"/>
                        <TextBox x:Name="PressureClassBox"
                                 Height="34"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,15">
                        <TextBlock Text="Pressão máxima de operação (bar)"/>
                        <TextBox x:Name="MaximumPressureBox"
                                 Height="34"
                                 Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,5,0,20"/>

                <TextBlock Text="Características dimensionais"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#17365D"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,15">
                        <TextBlock Text="Diâmetro externo (mm)"/>
                        <TextBox x:Name="OuterDiameterBox"
                                 Height="34"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,5,15">
                        <TextBlock Text="Espessura (mm)"/>
                        <TextBox x:Name="WallThicknessBox"
                                 Height="34"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,15">
                        <TextBlock Text="Diâmetro interno (mm)"/>
                        <TextBox x:Name="InternalDiameterBox"
                                 Height="34"
                                 Margin="0,5,0,0"
                                 IsReadOnly="True"
                                 Background="#E5EAF0"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,5,0,20"/>

                <TextBlock Text="Referências técnicas"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#17365D"
                           Margin="0,0,0,15"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Norma técnica / referência normativa"/>
                    <TextBox x:Name="StandardReferenceBox"
                             Height="34"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Descrição da fonte técnica"/>
                    <TextBox x:Name="SourceDescriptionBox"
                             Height="65"
                             Margin="0,5,0,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Link da fonte técnica (opcional)"/>
                    <TextBox x:Name="SourceUrlBox"
                             Height="34"
                             Margin="0,5,0,0"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTÕES -->
        <Border Grid.Row="2"
                Background="White"
                Padding="20"
                BorderBrush="#D9E0E8"
                BorderThickness="0,1,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="CANCELAR"
                        Width="120"
                        Height="38"
                        Margin="0,0,10,0"
                        IsCancel="True"/>

                <Button x:Name="SaveButton"
                        Content="SALVAR PRODUTO"
                        Width="160"
                        Height="38"
                        Background="#17365D"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        IsDefault="True"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>

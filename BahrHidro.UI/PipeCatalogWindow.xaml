<Window x:Class="BahrHidro.UI.PipeCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bahr Hidro | Catálogo de Tubulações"
        Height="760" Width="1250"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F1F4F9">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0"
                Background="#192957"
                CornerRadius="12"
                Padding="24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="BAHR HIDRO"
                           Foreground="White"
                           FontSize="27"
                           FontWeight="Bold"/>
                <TextBlock Text="CATÁLOGO TÉCNICO DE TUBULAÇÕES"
                           Foreground="#DCE5FF"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- FILTROS E AÇÕES -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,18,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="PESQUISAR"
                               FontWeight="SemiBold"
                               Foreground="#192957"/>
                    <TextBox x:Name="SearchBox"
                             Height="34"
                             Margin="0,7,0,0"
                             VerticalContentAlignment="Center"
                             Padding="8"
                             ToolTip="Nome ou fabricante"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="MATERIAL"
                               FontWeight="SemiBold"
                               Foreground="#192957"/>
                    <ComboBox x:Name="MaterialFilter"
                              Height="34"
                              Margin="0,7,0,0"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="PVC Soldável"/>
                        <ComboBoxItem Content="PVC Roscável"/>
                        <ComboBoxItem Content="PPR"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="APLICAÇÃO"
                               FontWeight="SemiBold"
                               Foreground="#192957"/>
                    <ComboBox x:Name="ApplicationFilter"
                              Height="34"
                              Margin="0,7,0,0"
                              IsEnabled="False"
                              ToolTip="Disponível em uma próxima etapa">
                        <ComboBoxItem Content="Não disponível nesta versão"
                                      IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="NewProductButton"
                        Grid.Column="3"
                        Content="+ NOVO PRODUTO"
                        Width="155"
                        Height="38"
                        Margin="8,22,0,0"
                        Background="#2864E8"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="NewProductButton_Click"/>
            </Grid>
        </Border>

        <!-- TABELA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="PRODUTOS CADASTRADOS"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#192957"
                           Margin="0,0,0,16"/>

                <DataGrid Grid.Row="1"
                          x:Name="PipeDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="42"
                          Background="White"
                          BorderThickness="0"
                          AlternatingRowBackground="#F5F7FC">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FABRICANTE"
                                            Binding="{Binding Manufacturer}"
                                            Width="*"/>

                        <DataGridTextColumn Header="MATERIAL"
                                            Binding="{Binding Material}"
                                            Width="120"/>

                        <DataGridTextColumn Header="LINHA"
                                            Binding="{Binding ProductLine}"
                                            Width="*"/>

                        <DataGridTextColumn Header="DN"
                                            Binding="{Binding NominalDesignation}"
                                            Width="85"/>

                        <DataGridTextColumn Header="DIÂMETRO EXTERNO (mm)"
                                            Binding="{Binding OuterDiameterMm}"
                                            Width="160"/>

                        <DataGridTextColumn Header="ESPESSURA (mm)"
                                            Binding="{Binding WallThicknessMm}"
                                            Width="130"/>

                        <DataGridTextColumn Header="DIÂMETRO INTERNO (mm)"
                                            Binding="{Binding InternalDiameterMm}"
                                            Width="150"/>

                        <DataGridTextColumn Header="PRESSÃO (bar)"
                                            Binding="{Binding MaximumOperatingPressureBar}"
                                            Width="110"/>

                        <DataGridTemplateColumn Header="AÇÕES" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="EDITAR"
                                                Tag="{Binding Id}"
                                                Click="EditProduct_Click"
                                                Background="#2864E8"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="9,5"
                                                Margin="2"
                                                Cursor="Hand"/>

                                        <Button Content="EXCLUIR"
                                                Tag="{Binding Id}"
                                                Click="DeleteProduct_Click"
                                                Background="#DC2626"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Padding="9,5"
                                                Margin="2"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- RODAPÉ -->
        <TextBlock Grid.Row="3"
                   Text="BAHR HIDRO"
                   Foreground="#64748B"
                   FontSize="10"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</Window>

<Window x:Class="BahrHidro.UI.FittingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleção de Conexões"
        Height="550" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="CONEXÕES E REGISTROS" FontSize="18" FontWeight="Bold" Foreground="#172554"/>
        <TextBlock Grid.Row="0" Text="Insira a quantidade de cada peça presente no trecho." Foreground="#64748B" FontSize="12" Margin="0,24,0,10"/>
        
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FittingsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1E293B"/>
                                <TextBlock Grid.Column="1" Text="{Binding KValueDisplay}" Foreground="#64748B" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="4" FontSize="14" FontWeight="Bold" Background="#F8FAFC"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="CONFIRMAR E APLICAR" Click="Confirmar_Click" Height="44" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
    </Grid>
</Window>
<Window x:Class="BahrHidro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BahrHidro.UI"
        Title="Bahr Hidro - Engenharia Hidráulica e BIM"
        Height="780" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="RevitActionButton">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="RevitApplyButton">
            <Setter Property="Background" Value="#15803D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- CABEÇALHO GLOBAL SUPERIOR -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BAHR HIDRO" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text=" | Plataforma de Engenharia Hidráulica &amp; BIM" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Início" Background="#1E293B" Foreground="White" FontWeight="SemiBold" Padding="14,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnIrInicio_Click"/>
                    <Button Content="Catálogo de Tubos" Style="{StaticResource PrimaryButton}" Click="AbrirCatalogo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NAVEGADOR LATERAL EM ÁRVORE -->
        <Border DockPanel.Dock="Left" Width="260" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#E2E8F0" Padding="14,10" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                    <TextBlock Text="NAVEGADOR DE PROJETO" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                </Border>

                <TreeView x:Name="NavegadorTree" BorderThickness="0" Background="Transparent" Padding="8,10" SelectedItemChanged="NavegadorTree_SelectedItemChanged">
                    <TreeViewItem x:Name="NavInicio" Header="Início / Visão Geral" Tag="Inicio" IsSelected="True" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8"/>

                    <TreeViewItem Header="HIDRÁULICA (NBR 5626)" IsExpanded="True" FontWeight="Bold" Foreground="#0F172A">
                        <TreeViewItem x:Name="NavTracado3D" Header="Traçado Automático 3D" Tag="Tracado3D" FontWeight="Normal" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavAguaFria" Header="Água Fria (Rede BIM 3D)" Tag="AguaFria" FontWeight="Normal" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavBomba" Header="Pressurização / Bomba" Tag="Bomba" FontWeight="Normal" Foreground="#334155"/>
                        <TreeViewItem x:Name="NavAguaQuente" Header="Água Quente (Boiler)" Tag="AguaQuente" FontWeight="Normal" Foreground="#334155"/>
                        <TreeViewItem x:Name="NavReservatorios" Header="Reservatórios" Tag="Reservatorios" FontWeight="Normal" Foreground="#334155"/>
                    </TreeViewItem>

                    <TreeViewItem Header="SANITÁRIO &amp; DRENAGEM" IsExpanded="True" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0">
                        <TreeViewItem x:Name="NavEsgoto" Header="Esgoto (NBR 8160)" Tag="Esgoto" FontWeight="Normal" Foreground="#334155"/>
                        <TreeViewItem x:Name="NavPluvial" Header="Águas Pluviais (NBR 10844)" Tag="Pluvial" FontWeight="Normal" Foreground="#334155"/>
                    </TreeViewItem>

                    <TreeViewItem Header="ENTREGÁVEIS" IsExpanded="True" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0">
                        <TreeViewItem x:Name="NavMemorial" Header="Memorial de Cálculo (.xlsx)" Tag="Memorial" FontWeight="Normal" Foreground="#334155"/>
                    </TreeViewItem>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ÁREA PRINCIPAL DE CONTEÚDO -->
        <Border Margin="12" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
            <Grid>
                <!-- 0. TELA INICIAL / VISÃO GERAL -->
                <ScrollViewer x:Name="PanelInicio" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="28">
                    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
                        <Border Background="#0F172A" CornerRadius="8" Padding="24" Margin="0,0,0,20">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="BEM-VINDO AO BAHR HIDRO" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Automação Hidrossanitária &amp; BIM para Revit 2026" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="InicioProjetoStatusText" Text="Prepare o catálogo de tubulações, importe elementos do modelo 3D e execute os dimensionamentos normativos." Foreground="#CBD5E1" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Catálogo -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="1. CATÁLOGO DE TUBULAÇÕES" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="InicioCatalogoStatusText" Text="Verificando bitolas cadastradas..." FontSize="13" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button Content="Abrir Catálogo de Tubos" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="AbrirCatalogo_Click"/>
                                    <Button Content="Carregar Padrão NBR 5648 (DN 20-110)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnCarregarPadraoInicio_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Rede BIM 3D -->
                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="2. REDE HIDRÁULICA BIM 3D" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="InicioRedeStatusText" Text="Nenhuma rede carregada. Importe do modelo 3D do Revit para dimensionar." FontSize="13" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button x:Name="BtnImportarInicioRevit" Content="Detectar Rede Automática (3D)" Style="{StaticResource RevitActionButton}" Height="36" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="DetectarRedeAutoRevit_Click"/>
                                    <Button Content="Traçado Automático de Tubos 3D" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnIrTracado3D_Click"/>
                                    <Button Content="Ir para Água Fria (Rede BIM 3D)" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrAguaFria_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Leitura Automática & Steel Frame -->
                            <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="3. LEITURA AUTOMÁTICA &amp; LSF" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>
                                    <TextBlock Text="Leitura automática de aparelhos sanitários, coberturas e ambientes já integrada. Próxima etapa: traçado automático para Light Steel Framing." FontSize="13" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button Content="Abrir Esgoto Sanitário" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnIrEsgoto_Click"/>
                                    <Button Content="Abrir Memorial Executivo" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrMemorial_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 0B. TRAÇADO AUTOMÁTICO 3D (ROTEAMENTO BIM IFC/DWG) -->
                <DockPanel x:Name="PanelTracado3D" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsTracado3D" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="1. Detectar Pontos (IFC / DWG)" Style="{StaticResource RevitActionButton}" Margin="0,0,8,0" Click="DetectarPontosTracado_Click"/>
                                <Button Content="2. Gerar Traçado Automático no 3D" Style="{StaticResource RevitApplyButton}" Click="ExecutarTracado3D_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Traçado Automático de Tubulações 3D (IFC, DWG &amp; Revit)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Detecta louças e metais em vínculos IFC, blocos DWG ou cliques manuais e traça a rede completa no 3D." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1160" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.95*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Coluna Esquerda: Configurações e Clique Manual -->
                            <StackPanel Grid.Column="0">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="1. Disciplina, Plano e Proteção Steel Frame" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                                        <TextBlock Text="Sistema a Traçar no 3D" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TracadoDisciplinaComboBox" SelectedIndex="0" Margin="0,0,0,10" Padding="6" SelectionChanged="TracadoDisciplinaComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Água Fria (ABNT NBR 5626 — Alimentação + Ramais)" Tag="ColdWater"/>
                                            <ComboBoxItem Content="Água Quente (ABNT NBR 7198 — Afastado 15 cm da Água Fria)" Tag="HotWater"/>
                                            <ComboBoxItem Content="Esgoto Sanitário (ABNT NBR 8160 — Com Declividade 1% e 2%)" Tag="SanitarySewer"/>
                                            <ComboBoxItem Content="Ventilação Sanitária (ABNT NBR 8160 — Colunas DN 50 mm)" Tag="Ventilation"/>
                                            <ComboBoxItem Content="Águas Pluviais (ABNT NBR 10844 — Condutores Verticais do Telhado)" Tag="StormDrainage"/>
                                        </ComboBox>

                                        <TextBlock Text="Direção do Traçado Principal" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TracadoPlanoComboBox" SelectedIndex="0" Margin="0,0,0,10" Padding="6" SelectionChanged="TracadoPlanoComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Por Cima (Entreforro / Laje — descendo até os pontos)" Tag="Top"/>
                                            <ComboBoxItem Content="Por Baixo (Piso / Contrapiso — subindo até os pontos)" Tag="Bottom"/>
                                        </ComboBox>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nível de Referência (Pavimento)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="TracadoNivelComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cota Relativa ao Nível (m)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TracadoOffsetTextBox" Text="2,60"/>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="ChkDesviarSteelFrame" IsChecked="True"
                                                  Content="Desviar automaticamente de perfis Steel Frame (zero colisão / sem furação)"
                                                  FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="2. Padrões do Template Revit" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                                        <TextBlock Text="Sistema de Tubulação (Piping System Type)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TracadoSystemTypeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10" Padding="6"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tipo de Tubo (Pipe Type)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="TracadoPipeTypeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Bitola Inicial (mm)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="TracadoDiametroComboBox" SelectedIndex="1" Padding="6">
                                                    <ComboBoxItem Content="20 mm (1/2&quot;)" Tag="20"/>
                                                    <ComboBoxItem Content="25 mm (3/4&quot;)" Tag="25"/>
                                                    <ComboBoxItem Content="32 mm (1&quot;)" Tag="32"/>
                                                    <ComboBoxItem Content="40 mm (1 1/4&quot;)" Tag="40"/>
                                                    <ComboBoxItem Content="50 mm (1 1/2&quot;)" Tag="50"/>
                                                    <ComboBoxItem Content="75 mm (3&quot;)" Tag="75"/>
                                                    <ComboBoxItem Content="100 mm (4&quot;)" Tag="100"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Inserção Manual Rápida para DWG sem blocos -->
                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="3. Marcação Rápida no DWG / 3D (Opcional)" FontSize="13" FontWeight="Bold" Foreground="#78350F" Margin="0,0,0,4"/>
                                        <TextBlock Text="Se o DWG veio apenas com linhas soltas (sem blocos), escolha o aparelho e clique na planta:" FontSize="12" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="TracadoPontoManualTipoComboBox" Grid.Column="0" Height="32" SelectedIndex="0">
                                                <ComboBoxItem Content="Vaso Sanitário (H = 0,20 m | ΣP = 0,3)" Tag="Vaso Sanitário"/>
                                                <ComboBoxItem Content="Lavatório / Cuba (H = 0,60 m | ΣP = 0,3)" Tag="Lavatório"/>
                                                <ComboBoxItem Content="Chuveiro / Ducha (H = 2,10 m | ΣP = 0,4)" Tag="Chuveiro"/>
                                                <ComboBoxItem Content="Pia de Cozinha (H = 0,60 m | ΣP = 0,7)" Tag="Pia de Cozinha"/>
                                                <ComboBoxItem Content="Tanque (H = 0,90 m | ΣP = 0,7)" Tag="Tanque"/>
                                                <ComboBoxItem Content="Máquina de Lavar (H = 0,90 m | ΣP = 1,0)" Tag="Máquina de Lavar"/>
                                            </ComboBox>

                                            <Button Grid.Column="2" Content="+ Clicar no DWG/3D" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="AdicionarPontoManualDwg_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Coluna Direita: Lista de Pontos Detectados + Geração -->
                            <StackPanel Grid.Column="2">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Detectar (IFC / DWG)" Style="{StaticResource RevitActionButton}" Height="30" Padding="10,0" Margin="0,0,6,0" Click="DetectarPontosTracado_Click"/>
                                                <Button Content="Limpar Lista" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Click="LimparPontosTracado_Click"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Pontos de Consumo Detectados (IFC / DWG / Revit)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock x:Name="TracadoTemplateStatusText" Text="Clique em 'Detectar (IFC / DWG)' para ler louças e metais da arquitetura." FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <DataGrid x:Name="TracadoPontosDataGrid" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Usar" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                                <DataGridTextColumn Header="Ponto / Aparelho" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Origem" Binding="{Binding SourceType}" IsReadOnly="True" Width="70"/>
                                                <DataGridTextColumn Header="Posição" Binding="{Binding CoordinatesDisplay}" IsReadOnly="True" Width="110"/>
                                                <DataGridTextColumn Header="Altura H (m)" Binding="{Binding PointHeightMeters, StringFormat=N2}" Width="80"/>
                                                <DataGridTextColumn Header="Peso ΣP" Binding="{Binding Weight, StringFormat=N2}" Width="65"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="Gerar Traçado Automático no 3D" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="ExecutarTracado3D_Click"/>
                                            <Button Content="Ir para Água Fria (Dimensionar)" Style="{StaticResource SecondaryButton}" Click="BtnIrAguaFria_Click"/>
                                        </StackPanel>

                                        <TextBlock x:Name="TracadoResumoGeracaoText" Text="Resultado: Aguardando geração do traçado." FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TracadoLogTextBox" Height="95" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#F8FAFC" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Documentação Automática BIM, Clash Check e Pranchas -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="4. Documentação Automática, Clash Check 3D e Pranchas" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                        <TextBlock Text="Audita interferências contra o Steel Frame, gera vistas isométricas 3D (1:25 c/ Tags) e monta as pranchas de plotagem." FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Content="1. Verificar Colisões (Steel Frame)" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,6,6" Click="VerificarColisoesSteelFrame_Click"/>
                                            <Button Content="2. Gerar Isométricos 3D (c/ Tags)" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,6,6" Click="GerarIsometricos3D_Click"/>
                                            <Button Content="3. Gerar Pranchas (Plotagem)" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="GerarPranchasPlotagem_Click"/>
                                            <Button Content="Taggear Vista Atual" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,0,6" Click="TaggearTubosVistaAtual_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 1. ÁGUA FRIA (REDE BIM 3D - SOMENTE LEITURA AUTOMÁTICA) -->
                <DockPanel x:Name="PanelAguaFria" Visibility="Collapsed">
                    <!-- Cabeçalho Padronizado do Módulo -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsAguaFria" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Detectar Rede Automática (3D)" Style="{StaticResource RevitActionButton}" Margin="0,0,8,0" Click="DetectarRedeAutoRevit_Click"/>
                                <Button Content="Selecionar Início no 3D" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,0" Click="ImportarRevit_Click"/>
                                <Button Content="Aplicar Diâmetros no Revit" Style="{StaticResource RevitApplyButton}" Click="AplicarRevit_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Rede de Água Fria — Dimensionamento Hidráulico (NBR 5626)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Leitura topológica automática do modelo 3D, cálculo de vazões pelos pesos relativos e dimensionamento comercial." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <StackPanel>
                            <!-- TABELAS DE LEITURA DO MODELO 3D -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PAINEL ESQUERDO: NÓS E RESERVATÓRIOS -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="ResumoRedeText" DockPanel.Dock="Right" Text="0 elementos" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                            <TextBlock Text="1. Nós e Reservatórios Lidos do Modelo 3D" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                        </DockPanel>

                                        <DataGrid x:Name="NosDataGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Identificação" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="100"/>
                                                <DataGridTextColumn Header="Cota (m)" Binding="{Binding ElevationDisplay}" Width="75"/>
                                                <DataGridTextColumn Header="Vazão (L/s)" Binding="{Binding DemandDisplay}" Width="80"/>
                                                <DataGridTextColumn Header="Peso (ΣP)" Binding="{Binding WeightDisplay}" Width="75"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- PAINEL DIREITO: TRECHOS DE TUBULAÇÃO -->
                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="ResumoTrechosText" DockPanel.Dock="Right" Text="0 trecho(s)" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                            <TextBlock Text="2. Trechos de Tubulação Lidos do Modelo 3D" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                        </DockPanel>

                                        <DataGrid x:Name="TrechosDataGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Trecho" Binding="{Binding Name}" Width="85"/>
                                                <DataGridTextColumn Header="Ligação (Montante → Jusante)" Binding="{Binding ConnectionDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="Comp. (m)" Binding="{Binding LengthDisplay}" Width="75"/>
                                                <DataGridTextColumn Header="Ø (mm)" Binding="{Binding DiameterDisplay}" Width="65"/>
                                                <DataGridTextColumn Header="K" Binding="{Binding KDisplay}" Width="55"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- BARRA DE CÁLCULO HIDRÁULICO -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Viscosidade Cinemática (m²/s):" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="RedeViscosidadeTextBox" Width="130" Text="0,000001003" Margin="0,0,16,0"/>
                                        <Button Content="Calcular Rede Hidráulica" Style="{StaticResource PrimaryButton}" Click="CalcularRede_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusCalculoAguaFriaText" DockPanel.Dock="Right" Text="Importe a rede 3D do Revit e clique em Calcular." Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- RESUMO DE ALTERAÇÕES E AUDITORIA DE TUBULAÇÕES -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <DockPanel>
                                    <CheckBox x:Name="ChkSomenteTrocados" DockPanel.Dock="Right" Content="Mostrar apenas tubos trocados"
                                              FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"
                                              Checked="ChkSomenteTrocados_Changed" Unchecked="ChkSomenteTrocados_Changed"/>
                                    <StackPanel>
                                        <TextBlock Text="RELATÓRIO DE SUBSTITUIÇÃO E DIMENSIONAMENTO DOS TUBOS" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="ResumoTrocasTubosText" Text="Calcule a rede para visualizar quais tubos foram alterados, o motivo técnico e o impacto hidráulico." FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- TABELA PRINCIPAL: COMPARATIVO DE TUBOS TROCADOS E MOTIVOS -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Resultados por Trecho — Comparativo (De → Para), Impacto Hidráulico e Motivo Técnico (clique em um trecho para ajustar manualmente)"
                                           FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                <DataGrid x:Name="ResultadosTrechosDataGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="True" Background="White"
                                          SelectionMode="Single" SelectionChanged="ResultadosTrechosDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Trecho" Binding="{Binding Name}" Width="68"/>
                                        <DataGridTextColumn Header="Ligação" Binding="{Binding ConnectionDisplay}" Width="155"/>
                                        <DataGridTextColumn Header="Q (L/s)" Binding="{Binding FlowDisplay}" Width="62"/>
                                        <DataGridTextColumn Header="Ø Antigo" Binding="{Binding OriginalDiameterDisplay}" Width="72"/>
                                        <DataGridTextColumn Header="Ø Novo" Binding="{Binding DiameterDisplay}" Width="72"/>
                                        <DataGridTextColumn Header="Alteração" Binding="{Binding ChangeStatusDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="O que mudou (V e ΔH)" Binding="{Binding ImpactDisplay}" Width="210"/>
                                        <DataGridTextColumn Header="Por que foi trocado (Motivo Técnico)" Binding="{Binding ReasonDisplay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <!-- PAINEL INTERATIVO DE AJUSTE MANUAL DO TRECHO SELECIONADO + PRESSÕES NOS NÓS -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="0.85*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card de Inspeção e Edição Manual -->
                                <Border Grid.Column="0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="DetalheTrechoBadgeText" DockPanel.Dock="Right" Text="Nenhum trecho selecionado" FontSize="11" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                            <TextBlock Text="Inspeção e Ajuste Manual do Trecho Selecionado" FontSize="14" FontWeight="Bold" Foreground="#78350F"/>
                                        </DockPanel>

                                        <TextBlock x:Name="DetalheTrechoTituloText" Text="Clique em qualquer linha da tabela acima para inspecionar a troca e alterar o diâmetro manualmente."
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,6"/>

                                        <TextBlock x:Name="DetalheTrechoComparativoText" Text="Comparativo Antes → Depois: --"
                                                   FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                        <TextBlock x:Name="DetalheTrechoMotivoText" Text="Motivo Técnico: --"
                                                   FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="TrechoManualDiametroComboBox" Grid.Column="0" Height="32" DisplayMemberPath="Label" SelectedValuePath="DiameterMm"/>
                                            <Button x:Name="BtnAplicarManualTrecho" Grid.Column="2" Content="Aplicar Manual e Recalcular" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" IsEnabled="False" Click="AplicarDiametroManualTrecho_Click"/>
                                            <Button x:Name="BtnVoltarAutoTrecho" Grid.Column="4" Content="Voltar Auto" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" IsEnabled="False" Click="RestaurarDiametroAutoTrecho_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Pressões Disponíveis nos Nós -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pressões Disponíveis nos Nós" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                    <DataGrid x:Name="ResultadosNosDataGrid" Height="175" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nó" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="85"/>
                                            <DataGridTextColumn Header="Cota (m)" Binding="{Binding ElevationDisplay}" Width="65"/>
                                            <DataGridTextColumn Header="C. Piez." Binding="{Binding HeadDisplay}" Width="70"/>
                                            <DataGridTextColumn Header="Pressão (mca)" Binding="{Binding PressureDisplay}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 1B. PRESSURIZAÇÃO / BOMBA (ABA DEDICADA) -->
                <DockPanel x:Name="PanelBomba" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pressurização &amp; Dimensionamento de Bomba (NBR 5626)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Verificação automática de pressão dinâmica mínima nos pontos de consumo e dimensionamento do conjunto motobomba." FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1040" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Parâmetros & Resultado Direto -->
                            <StackPanel Grid.Column="0">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Parâmetros de Verificação" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Pressão Mínima Exigida (m.c.a.)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="BombaPressaoMinimaTextBox" Text="1,00"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Rendimento do Conjunto (%)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="BombaRendimentoTextBox" Text="60"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Verificar Pressurização da Rede" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="RecalcularBomba_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="BombaStatusCard" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Diagnóstico e Dimensionamento" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="BombaDiagnosticoText" Text="Calcule a rede de Água Fria para verificar automaticamente a necessidade de pressurização." FontWeight="Bold" FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                                <RowDefinition Height="28"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ponto Crítico Identificado:" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BombaNoCriticoText" Text="--"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pressão Atual no Ponto:" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BombaPressaoAtualText" Text="--"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Vazão de Projeto (Q):" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BombaVazaoText" Text="--"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Altura Manométrica (AMT):" FontWeight="Bold"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BombaAmtText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Potência Comercial Estimada:" FontWeight="Bold"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BombaPotenciaText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Sugestões Comerciais e Peças Obrigatórias -->
                            <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="SUGESTÕES COMERCIAIS &amp; PEÇAS OBRIGATÓRIAS" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="BombaSugestoesText" TextWrapping="Wrap" FontSize="13" Foreground="#14532D" LineHeight="20"
                                               Text="• Equipamento Recomendado: Pressurizador silencioso com inversor de frequência ou fluxostato automático (ex.: Grundfos Scala2 / CMB, Komeco TP40/TP80, Rowa Tango/Press).&#x0a;&#x0a;• Peças Obrigatórias no Barrilete (NBR 5626):&#x0a;  1. Válvula de retenção horizontal/vertical na sucção e no recalque;&#x0a;  2. Registros de esfera/gaveta antes e depois da bomba para manutenção;&#x0a;  3. By-pass com válvula de retenção para abastecimento por gravidade em falta de energia;&#x0a;  4. Manômetro com registro na saída do recalque;&#x0a;  5. Uniões e juntas flexíveis antivibração (essencial em estruturas Light Steel Framing)."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 2. ÁGUA QUENTE (BOILER) -->
                <DockPanel x:Name="PanelAguaQuente" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsAguaQuente" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Ler Ocupantes do Revit" Style="{StaticResource RevitActionButton}" Click="EstimarPopulacaoRevit_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dimensionamento de Reservatório Térmico (Boiler)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Cálculo de acumulação de água quente (NBR 7198 / NBR 5626), classificação de pressão e especificação de componentes." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1060" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Perfil da Edificação" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="BoilerPerfilComboBox" SelectedIndex="0" Margin="0,0,0,12" Padding="6"/>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Número de Ocupantes / Pessoas" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="BoilerOcupantesTextBox" Text="5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Pressão de Trabalho (m.c.a.)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="BoilerPressaoTextBox" Text="4,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Dimensionar Boiler" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CalcularBoiler_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Consumo Diário Estimado:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BoilerConsumoText" Text="--"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume de Acumulação:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BoilerVolumeText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Modelo Comercial Sugerido:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BoilerComercialText" Text="--" FontWeight="Bold" Foreground="#0F172A"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Classificação de Pressão:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BoilerTipoText" Text="--" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Sugestões Comerciais e Peças Obrigatórias (Boiler) -->
                            <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="SUGESTÕES COMERCIAIS &amp; PEÇAS OBRIGATÓRIAS (ÁGUA QUENTE)" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="BoilerSugestoesText" TextWrapping="Wrap" FontSize="13" Foreground="#14532D" LineHeight="20"
                                               Text="• Marcas e Linhas de Referência: Komeco (KSS / Inox), Bosch / Heliotek (MK / HP), Soletrol ou Cumulus (tanque interno em Aço Inox 304 ou 316L).&#x0a;&#x0a;• Tubulação Recomendada: PPR PN 20 / PN 25 (termofusão) ou CPVC Aquatherm (soldável), com isolamento térmico nos trechos embutidos em Steel Frame.&#x0a;&#x0a;• Peças Obrigatórias no Projeto (NBR 7198):&#x0a;  1. Válvula de segurança e alívio (pressão/temperatura) na saída de água quente;&#x0a;  2. Tubo de respiro (suspiro) acima do nível máximo da caixa d'água fria (para baixa pressão) ou válvula eliminadora de ar (alta pressão);&#x0a;  3. Válvula de retenção na entrada de alimentação de água fria;&#x0a;  4. Registros de esfera/gaveta na entrada, saída e dreno de limpeza."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 3. RESERVATÓRIOS -->
                <DockPanel x:Name="PanelReservatorios" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsReservatorios" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Ler População do Revit" Style="{StaticResource RevitActionButton}" Click="EstimarPopulacaoRevit_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dimensionamento de Reservatórios (NBR 5626)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Reservação superior e inferior (cisterna), capacidades comerciais recomendadas e acessórios obrigatórios de barrilete." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1060" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Categoria da Edificação" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CaixaPerfilComboBox" SelectedIndex="0" Margin="0,0,0,12" Padding="6"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="População Estimada (pessoas)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="CaixaPopulacaoTextBox" Text="5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Autonomia / Reserva (dias)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="CaixaDiasTextBox" Text="2"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Reserva Técnica de Incêndio (L)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="CaixaIncendioTextBox" Text="0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Percentual Cisterna Inferior (%)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="CaixaCisternaTextBox" Text="60"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Calcular Reservação" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CalcularCaixa_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Consumo Diário Total:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CaixaConsumoText" Text="--"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume Total Necessário:" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CaixaVolumeTotalText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Reservatório Superior:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CaixaSuperiorText" Text="--"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Reservatório Inferior (Cisterna):" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CaixaCisternaText" Text="--"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Sugestões Comerciais e Peças Obrigatórias (Reservatórios) -->
                            <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="SUGESTÕES COMERCIAIS &amp; PEÇAS OBRIGATÓRIAS (RESERVAÇÃO)" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="CaixaSugestoesText" TextWrapping="Wrap" FontSize="13" Foreground="#14532D" LineHeight="20"
                                               Text="• Modelos Comerciais Recomendados: Caixas d'água em Polietileno com tampa de rosca (Tigre / Fortlev / Acqualimp) ou Aço Inox 304 para reservatório superior; cisterna enterrada em Polietileno reforçado ou fibra.&#x0a;&#x0a;• Peças Obrigatórias no Projeto (ABNT NBR 5626):&#x0a;  1. Torneira de boia de vazão total na tubulação de alimentação;&#x0a;  2. Tubo extravasor (ladrão) com diâmetro 1 bitola acima da alimentação e descarga livre visível;&#x0a;  3. Tubulação de limpeza no fundo com registro de bloqueio;&#x0a;  4. Tubo de ventilação (suspiro) após o registro geral do barrilete;&#x0a;  5. Chave de boia elétrica (nível superior/inferior) para controle automático da bomba de recalque."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 4. ESGOTO SANITÁRIO -->
                <DockPanel x:Name="PanelEsgoto" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsEsgoto" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Ler Todos do Projeto" Style="{StaticResource RevitActionButton}" Margin="0,0,8,0" Click="ImportarEsgotoAutoRevit_Click"/>
                                <Button Content="Selecionar no 3D" Style="{StaticResource RevitApplyButton}" Click="ImportarEsgotoRevit_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Esgoto Sanitário — Dimensionamento por UHC (NBR 8160)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Contagem automática ou por seleção 3D dos aparelhos sanitários, diâmetro mínimo e peças obrigatórias." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Margin="24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Aparelhos Sanitários (UHC — NBR 8160)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                                <Button DockPanel.Dock="Bottom" Content="Dimensionar Ramal de Esgoto" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="CalcularEsgoto_Click"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SewerItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding UhcDisplay}" VerticalAlignment="Center" Foreground="#64748B"/>
                                                        <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Resultado do Dimensionamento" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="32"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Somatório de UHC:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EsgotoUhcText" Text="--" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo de Tubulação:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EsgotoTipoText" Text="--"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Diâmetro Nominal:" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EsgotoDiametroText" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Declividade Mínima:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EsgotoInclinacaoText" Text="--"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Sugestões Comerciais e Peças Obrigatórias (Esgoto) -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="SUGESTÕES TÉCNICAS &amp; PEÇAS OBRIGATÓRIAS (NBR 8160)" FontSize="12" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="EsgotoSugestoesText" TextWrapping="Wrap" FontSize="12" Foreground="#14532D" LineHeight="19"
                                               Text="• Linha Recomendada: Tubos e conexões PVC Esgoto Série Normal (ramais internos) e Série Reforçada (tubos de queda e subcoletores enterrados — Tigre / Amanco).&#x0a;• Peças Obrigatórias:&#x0a;  1. Caixa Sifonada (DN 100×100×50 ou DN 150×150×50) com grelha para lavatórios, chuveiros e ralos;&#x0a;  2. Caixa de Gordura individual/coletiva antes da rede principal (obrigatória para pia de cozinha);&#x0a;  3. Ramal e Coluna de Ventilação (DN 50 / DN 75) com terminal 30 cm acima da cobertura;&#x0a;  4. Caixas de Inspeção (CI 60×60 cm) nas mudanças de direção e a cada 15 m."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- 5. ÁGUAS PLUVIAIS -->
                <DockPanel x:Name="PanelPluvial" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsPluvial" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Ler Telhados do Projeto" Style="{StaticResource RevitActionButton}" Margin="0,0,8,0" Click="ImportarPluvialAutoRevit_Click"/>
                                <Button Content="Capturar Telhado no 3D" Style="{StaticResource RevitApplyButton}" Click="ImportarPluvialRevit_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Águas Pluviais — Calhas e Condutores (NBR 10844)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Leitura automática de coberturas no Revit 3D, cálculo de vazão de projeto, calhas e condutores verticais." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <local:RainwaterView x:Name="RainwaterViewControl" />
                </DockPanel>

                <!-- 6. MEMORIAL DE CÁLCULO & PROJETO (DASHBOARD EXECUTIVO) -->
                <DockPanel x:Name="PanelMemorial" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Memorial de Cálculo &amp; Dados do Projeto BIM" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Cadastro técnico do empreendimento, consolidação dos resultados normativos e exportação do memorial (.xlsx)." FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1120" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Coluna Esquerda: Identificação Completa -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="1. Identificação do Empreendimento e Responsabilidade Técnica" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                    <TextBlock Text="Identificação da Obra / Empreendimento" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MemObraTextBox" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Proprietário / Cliente" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="MemClienteTextBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Endereço da Obra" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="MemEnderecoTextBox"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Responsável Técnico (Engenheiro)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="MemEngenheiroTextBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Registro CREA / CAU" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="MemCreaTextBox"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="1.3*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Nº ART / RRT" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="MemArtTextBox" Text=""/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Revisão" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="MemRevisaoTextBox" Text="R00"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Normas Aplicadas" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="MemNormasTextBox" Text="NBR 5626 / 8160 / 10844" IsReadOnly="True" Background="#F1F5F9"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Quantitativo Executivo de Materiais (BOM 3D — Tubos e Conexões)" FontSize="12" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,6"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Margem de Perda (%)" FontSize="11" FontWeight="SemiBold" Foreground="#14532D" Margin="0,0,0,2"/>
                                                    <TextBox x:Name="MemMargemPerdaTextBox" Text="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                    <Button x:Name="BtnExtrairBom3D" Content="Extrair Lista de Materiais do 3D" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" HorizontalAlignment="Left" Click="ExtrairBomRevit_Click"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="MemBomPreviewText" Text="Gere o traçado ou dimensione a rede para incluir o quantitativo completo de tubos (varas 6m) e conexões no Excel." FontSize="11" Foreground="#14532D" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SalvarDadosRevitButton" Content="Salvar Dados no Projeto Revit" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,0,10,0" Click="SalvarDadosRevit_Click"/>
                                        <Button x:Name="ExportarMemorialAbaButton" Content="Exportar Memorial + Lista de Materiais (.xlsx)" Style="{StaticResource PrimaryButton}" Click="ExportarMemorialAba_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Coluna Direita: Resumo Executivo Consolidado -->
                            <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="2. Resumo Consolidado dos Dimensionamentos" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="ÁGUA FRIA (NBR 5626)" FontSize="11" FontWeight="Bold" Foreground="#1E3A8A"/>
                                            <TextBlock x:Name="MemStatusRedeText" Text="Pendente: importe e calcule a rede na aba Água Fria." FontSize="12" Foreground="#1D4ED8" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="PRESSURIZAÇÃO / BOMBA" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock x:Name="MemStatusBombaText" Text="Aguardando cálculo da rede de Água Fria." FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="ÁGUA QUENTE (BOILER)" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock x:Name="MemStatusBoilerText" Text="Não dimensionado." FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="RESERVATÓRIOS (NBR 5626)" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock x:Name="MemStatusCaixaText" Text="Não dimensionado." FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="ESGOTO SANITÁRIO (NBR 8160)" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock x:Name="MemStatusEsgotoText" Text="Não dimensionado." FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="ÁGUAS PLUVIAIS (NBR 10844)" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock x:Name="MemStatusPluvialText" Text="Não dimensionado." FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>

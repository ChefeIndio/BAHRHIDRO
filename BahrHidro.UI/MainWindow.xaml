<Window x:Class="BahrHidro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BahrHidro.UI"
        Title="Bahr Hidro - Engenharia Hidráulica e BIM"
        Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- CABEÇALHO SUPERIOR -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BAHR HIDRO" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text=" | Plataforma de Engenharia Hidráulica &amp; BIM" Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel x:Name="RevitBimToolbar" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0">
                        <Button x:Name="ImportarRevitButton" Content="Importar Rede 3D (Revit)" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="ImportarRevit_Click"/>
                        <Button x:Name="AplicarRevitButton" Content="Aplicar Diâmetros no Revit" Background="#15803D" Foreground="White" FontWeight="SemiBold" Padding="12,8" BorderThickness="0" Cursor="Hand" Click="AplicarRevit_Click"/>
                    </StackPanel>
                    <Button Content="Catálogo de Tubos" Style="{StaticResource PrimaryButton}" Click="AbrirCatalogo_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NAVEGADOR LATERAL EM ÁRVORE -->
        <Border DockPanel.Dock="Left" Width="260" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#E2E8F0" Padding="14,10" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                    <TextBlock Text="NAVEGADOR DE PROJETO" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                </Border>

                <TreeView x:Name="NavegadorTree" BorderThickness="0" Background="Transparent" Padding="8,10" SelectedItemChanged="NavegadorTree_SelectedItemChanged">
                    <TreeViewItem Header="HIDRÁULICA (NBR 5626)" IsExpanded="True" FontWeight="Bold" Foreground="#0F172A">
                        <TreeViewItem x:Name="NavAguaFria" Header="Água Fria (Rede BIM 3D)" Tag="AguaFria" IsSelected="True" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavAguaQuente" Header="Água Quente (Boiler)" Tag="AguaQuente" FontWeight="Normal" Foreground="#334155"/>
                        <TreeViewItem x:Name="NavReservatorios" Header="Reservatórios" Tag="Reservatorios" FontWeight="Normal" Foreground="#334155"/>
                    </TreeViewItem>

                    <TreeViewItem Header="SANITÁRIO &amp; DRENAGEM" IsExpanded="True" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0">
                        <TreeViewItem x:Name="NavEsgoto" Header="Esgoto (NBR 8160)" Tag="Esgoto" FontWeight="Normal" Foreground="#334155"/>
                        <TreeViewItem x:Name="NavPluvial" Header="Águas Pluviais (NBR 10844)" Tag="Pluvial" FontWeight="Normal" Foreground="#334155"/>
                    </TreeViewItem>

                    <TreeViewItem Header="ENTREGÁVEIS" IsExpanded="True" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0">
                        <TreeViewItem x:Name="NavMemorial" Header="Memorial de Cálculo (.xlsx)" Tag="Memorial" FontWeight="Normal" Foreground="#334155"/>
                    </TreeViewItem>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ÁREA PRINCIPAL DE CONTEÚDO -->
        <Border Margin="12" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
            <Grid>
                <!-- 1. ÁGUA FRIA (REDE BIM 3D) -->
                <ScrollViewer x:Name="PanelAguaFria" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Rede de Água Fria — Dimensionamento Hidráulico (NBR 5626)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <!-- SECÇÃO NÓS E TRECHOS -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PAINEL ESQUERDO: NÓS -->
                            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="1. Nós e Reservatórios" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                        <Border x:Name="NoModoEdicaoBadge" Background="#EFF6FF" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="NoModoEdicaoText" Text="Modo: Novo elemento" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Tipo de Elemento" FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="NoTipoComboBox" SelectedIndex="1" SelectionChanged="NoTipoComboBox_SelectionChanged" Padding="5">
                                                <ComboBoxItem Content="Reservatório" Tag="Reservoir"/>
                                                <ComboBoxItem Content="Nó de Derivação" Tag="Junction"/>
                                                <ComboBoxItem Content="Ponto de Consumo" Tag="ConsumptionPoint"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Nome / Identificação" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="NoNomeTextBox"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Cota Geométrica (m)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="NoCotaTextBox" Text="0,00"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Demanda Direta (L/s)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="NoDemandaTextBox" Text="0,00"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock Text="Peso Relativo (ΣP)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="NoPesoTextBox" Text="0,00"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Salvar Nó" Style="{StaticResource PrimaryButton}" Click="SalvarNo_Click" Margin="0,0,6,0"/>
                                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="CancelarEdicaoNo_Click" Margin="0,0,6,0"/>
                                        <Button Content="Editar" Style="{StaticResource SecondaryButton}" Click="EditarNo_Click" Margin="0,0,6,0"/>
                                        <Button Content="Excluir" Style="{StaticResource SecondaryButton}" Click="ExcluirNo_Click"/>
                                    </StackPanel>

                                    <DataGrid x:Name="NosDataGrid" Height="160" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="NosDataGrid_MouseDoubleClick" Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="95"/>
                                            <DataGridTextColumn Header="Cota (m)" Binding="{Binding ElevationDisplay}" Width="70"/>
                                            <DataGridTextColumn Header="Vazão" Binding="{Binding DemandDisplay}" Width="65"/>
                                            <DataGridTextColumn Header="Peso" Binding="{Binding WeightDisplay}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="ResumoRedeText" Text="Total: 0 elementos" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- PAINEL DIREITO: TRECHOS -->
                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="2. Trechos de Tubulação" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                        <Border x:Name="TrechoModoEdicaoBadge" Background="#EFF6FF" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TrechoModoEdicaoText" Text="Modo: Novo trecho" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Nome do Trecho" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoNomeTextBox"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Nó Montante (Início)" FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="TrechoNoInicialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="4">
                                            <TextBlock Text="Nó Jusante (Fim)" FontSize="12" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="TrechoNoFinalComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Comprimento (m)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoComprimentoTextBox" Text="10,00"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Diâmetro (mm ou Auto)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoDiametroTextBox" Text="Auto"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="4">
                                            <TextBlock Text="Rugosidade (mm)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoRugosidadeTextBox" Text="0,001"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock Text="Perda Localizada (K)" FontSize="12" FontWeight="SemiBold"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="+" Width="28" Margin="4,0,0,0" Style="{StaticResource PrimaryButton}" Padding="0" Click="CalcularConexoes_Click" ToolTip="Calcular K por conexões"/>
                                                <TextBox x:Name="TrechoCoeficienteKTextBox" Text="0"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                            <TextBlock Text="Vazão Manual (Opcional)" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoVazaoTextBox"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Salvar Trecho" Style="{StaticResource PrimaryButton}" Click="SalvarTrecho_Click" Margin="0,0,6,0"/>
                                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="CancelarEdicaoTrecho_Click" Margin="0,0,6,0"/>
                                        <Button Content="Editar" Style="{StaticResource SecondaryButton}" Click="EditarTrecho_Click" Margin="0,0,6,0"/>
                                        <Button Content="Excluir" Style="{StaticResource SecondaryButton}" Click="ExcluirTrecho_Click"/>
                                    </StackPanel>

                                    <DataGrid x:Name="TrechosDataGrid" Height="160" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="TrechosDataGrid_MouseDoubleClick" Background="White">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Trecho" Binding="{Binding Name}" Width="75"/>
                                            <DataGridTextColumn Header="Ligação" Binding="{Binding ConnectionDisplay}" Width="*"/>
                                            <DataGridTextColumn Header="L (m)" Binding="{Binding LengthDisplay}" Width="60"/>
                                            <DataGridTextColumn Header="Ø (mm)" Binding="{Binding DiameterDisplay}" Width="65"/>
                                            <DataGridTextColumn Header="K" Binding="{Binding KDisplay}" Width="50"/>
                                            <DataGridTextColumn Header="Q (L/s)" Binding="{Binding FlowDisplay}" Width="65"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="ResumoTrechosText" Text="Total: 0 trecho(s)" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- BARRA DE CÁLCULO DA REDE -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Viscosidade (m²/s):" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="RedeViscosidadeTextBox" Text="0,000001003" Width="120" Margin="0,0,16,0"/>
                                    <Button Content="Calcular Rede Hidráulica" Style="{StaticResource PrimaryButton}" Click="CalcularRede_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="DimensionarBombaButton" Content="Verificar Pressurização / Bomba" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="DimensionarBomba_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="ExportarMemorialButton" Content="Exportar Memorial (.xlsx)" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="ExportarMemorial_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- TABELAS DE RESULTADOS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Resultados Hidráulicos por Trecho" FontWeight="Bold" Margin="0,0,0,6"/>
                                <DataGrid x:Name="ResultadosTrechosDataGrid" Height="180" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Trecho" Binding="{Binding Name}" Width="70"/>
                                        <DataGridTextColumn Header="Ligação" Binding="{Binding ConnectionDisplay}" Width="*"/>
                                        <DataGridTextColumn Header="Q (L/s)" Binding="{Binding FlowDisplay}" Width="65"/>
                                        <DataGridTextColumn Header="Ø (mm)" Binding="{Binding DiameterDisplay}" Width="65"/>
                                        <DataGridTextColumn Header="V (m/s)" Binding="{Binding VelocityDisplay}" Width="65"/>
                                        <DataGridTextColumn Header="Re" Binding="{Binding ReynoldsDisplay}" Width="65"/>
                                        <DataGridTextColumn Header="ΔH (mca)" Binding="{Binding HeadLossDisplay}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pressões Disponíveis nos Nós" FontWeight="Bold" Margin="0,0,0,6"/>
                                <DataGrid x:Name="ResultadosNosDataGrid" Height="180" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nó" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="85"/>
                                        <DataGridTextColumn Header="Cota" Binding="{Binding ElevationDisplay}" Width="60"/>
                                        <DataGridTextColumn Header="C. Piez." Binding="{Binding HeadDisplay}" Width="65"/>
                                        <DataGridTextColumn Header="Pressão (mca)" Binding="{Binding PressureDisplay}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. ÁGUA QUENTE (BOILER) -->
                <ScrollViewer x:Name="PanelAguaQuente" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Dimensionamento de Reservatório Térmico (Boiler)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Perfil da Edificação" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="BoilerPerfilComboBox" SelectedIndex="0" Margin="0,0,0,12" Padding="6"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Número de Ocupantes / Pessoas" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="BoilerOcupantesTextBox" Text="4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Pressão de Trabalho (m.c.a.)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="BoilerPressaoTextBox" Text="4,0"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Dimensionar Boiler" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CalcularBoiler_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Consumo Diário Estimado:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BoilerConsumoText" Text="--"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume de Acumulação:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BoilerVolumeText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Classificação de Pressão:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BoilerTipoText" Text="--" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. RESERVATÓRIOS -->
                <ScrollViewer x:Name="PanelReservatorios" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Dimensionamento de Reservatórios (NBR 5626)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Categoria da Edificação" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CaixaPerfilComboBox" SelectedIndex="0" Margin="0,0,0,12" Padding="6"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="População Estimada (pessoas)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CaixaPopulacaoTextBox" Text="5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Autonomia / Reserva (dias)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CaixaDiasTextBox" Text="2"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Reserva Técnica de Incêndio (L)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CaixaIncendioTextBox" Text="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Percentual Cisterna Inferior (%)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CaixaCisternaTextBox" Text="60"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Calcular Reservação" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CalcularCaixa_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Consumo Diário Total:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CaixaConsumoText" Text="--"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume Total Necessário:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CaixaVolumeTotalText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Reservatório Superior:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CaixaSuperiorText" Text="--"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Reservatório Inferior (Cisterna):" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CaixaCisternaText" Text="--"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. ESGOTO SANITÁRIO -->
                <Grid x:Name="PanelEsgoto" Visibility="Collapsed" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Aparelhos Sanitários (UHC — NBR 8160)" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Button DockPanel.Dock="Bottom" Content="Dimensionar Ramal de Esgoto" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="CalcularEsgoto_Click"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SewerItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding UhcDisplay}" VerticalAlignment="Center" Foreground="#64748B"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Resultado do Dimensionamento" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Somatório de UHC:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EsgotoUhcText" Text="--" FontWeight="Bold"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tipo de Tubulação:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="EsgotoTipoText" Text="--"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Diâmetro Nominal:" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EsgotoDiametroText" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Declividade Mínima:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EsgotoInclinacaoText" Text="--"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 5. ÁGUAS PLUVIAIS -->
                <Grid x:Name="PanelPluvial" Visibility="Collapsed">
                    <local:RainwaterView />
                </Grid>

                <!-- 6. MEMORIAL DE CÁLCULO & PROJETO -->
                <ScrollViewer x:Name="PanelMemorial" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Memorial de Cálculo &amp; Dados do Projeto BIM" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                        <TextBlock Text="Identificação da obra e geração do memorial descritivo em planilha Excel (.xlsx)." Foreground="#64748B" Margin="0,0,0,16"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Identificação da Obra / Empreendimento" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="MemObraTextBox" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Proprietário / Cliente" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MemClienteTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Endereço da Obra" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MemEnderecoTextBox"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Responsável Técnico (Engenheiro)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MemEngenheiroTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Registro CREA / CAU" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MemCreaTextBox"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SalvarDadosRevitButton" Content="Salvar Dados no Projeto Revit" Style="{StaticResource SecondaryButton}" Visibility="Collapsed" Margin="0,0,10,0" Click="SalvarDadosRevit_Click"/>
                                    <Button x:Name="ExportarMemorialAbaButton" Content="Exportar Memorial de Cálculo (.xlsx)" Style="{StaticResource PrimaryButton}" Click="ExportarMemorialAba_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Status do Dimensionamento para Exportação" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MemStatusRedeText" Text="Pendente: importe ou calcule a rede na aba 'Água Fria (Rede BIM 3D)' antes de exportar o memorial." Foreground="#1D4ED8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>

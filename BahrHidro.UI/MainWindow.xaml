<Window x:Class="BahrHidro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bahr Hidro | Dimensionamento"
        Height="780" Width="1100"
        MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#172554"
                CornerRadius="12"
                Padding="22">
            <StackPanel>
                <TextBlock Text="BAHR HIDRO"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>
                <TextBlock Text="DIMENSIONAMENTO HIDRÁULICO | ÁGUA FRIA"
                           Foreground="#BFDBFE"
                           FontSize="13"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="0,18,0,12"
                    Background="#F1F5F9"
                    BorderThickness="0"
                    FontSize="13">

            <!-- ABA 1: DIMENSIONAMENTO -->
            <TabItem Header="DIMENSIONAMENTO">
                <Grid Margin="4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="PARÂMETROS DO TRECHO"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#172554"/>

                            <TextBlock Text="Vazão de projeto (L/s)"
                                       Margin="0,28,0,7"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="VazaoTextBox"
                                     Text="0,30"
                                     FontSize="20"
                                     Padding="10"/>

                            <TextBlock Text="Velocidade limite (m/s)"
                                       Margin="0,22,0,7"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="VelocidadeTextBox"
                                     Text="2,00"
                                     FontSize="20"
                                     Padding="10"/>

                            <Button Content="DIMENSIONAR"
                                    Click="Calcular_Click"
                                    Height="48"
                                    Margin="0,28,0,0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button x:Name="AbrirCatalogoButton"
                                    Content="CATÁLOGO DE TUBULAÇÕES"
                                    Click="AbrirCatalogo_Click"
                                    Height="44"
                                    Margin="0,12,0,0"
                                    Background="#172554"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <TextBlock Text="Seleção baseada nos produtos cadastrados no catálogo."
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       Margin="0,20,0,0"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="12"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="RESULTADO DO DIMENSIONAMENTO"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#172554"/>

                            <TextBlock Text="Diâmetro interno mínimo"
                                       Foreground="#64748B"
                                       Margin="0,22,0,3"/>

                            <TextBlock x:Name="DiametroMinimoText"
                                       Text="--"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"/>

                            <Separator Margin="0,14"/>

                            <TextBlock Text="Diâmetro selecionado"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="DiametroSelecionadoText"
                                       Text="--"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#059669"
                                       Margin="0,3,0,0"/>

                            <TextBlock x:Name="DescricaoTuboText"
                                       Text="Aguardando cálculo"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <Separator Margin="0,14"/>

                            <TextBlock Text="Velocidade real"
                                       Foreground="#64748B"/>

                            <TextBlock x:Name="VelocidadeRealText"
                                       Text="--"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,3,0,0"/>

                            <TextBlock Text="Verificação do limite"
                                       Foreground="#64748B"
                                       Margin="0,14,0,4"/>

                            <TextBlock x:Name="StatusText"
                                       Text="Aguardando dimensionamento"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ABA 2: ANÁLISE HIDRÁULICA -->
            <TabItem Header="ANÁLISE HIDRÁULICA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="White"
                                CornerRadius="12"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="PARÂMETROS HIDRÁULICOS"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#172554"/>

                                <TextBlock Text="Comprimento da tubulação (m)"
                                           Margin="0,22,0,6"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="ComprimentoTextBox"
                                         Text="20,00"
                                         FontSize="18"
                                         Padding="9"/>

                                <TextBlock Text="Rugosidade absoluta (mm)"
                                           Margin="0,16,0,6"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="RugosidadeTextBox"
                                         Text="0,001"
                                         FontSize="18"
                                         Padding="9"/>

                                <TextBlock Text="Coeficiente de perdas localizadas (K)"
                                           Margin="0,16,0,6"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="CoeficienteKTextBox"
                                         Text="0"
                                         FontSize="18"
                                         Padding="9"/>

                                <TextBlock Text="Viscosidade cinemática (m²/s)"
                                           Margin="0,16,0,6"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="ViscosidadeTextBox"
                                         Text="0,000001004"
                                         FontSize="18"
                                         Padding="9"/>

                                <Button Content="ANALISAR TRECHO"
                                        Click="AnalisarTrecho_Click"
                                        Height="48"
                                        Margin="0,24,0,0"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"/>

                                <TextBlock Text="Primeiro dimensione o trecho na aba anterior para selecionar o produto do catálogo."
                                           Foreground="#64748B"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="White"
                                CornerRadius="12"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="RESULTADOS DA ANÁLISE"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#172554"/>

                                <TextBlock Text="Velocidade real"
                                           Foreground="#64748B"
                                           Margin="0,18,0,2"/>

                                <TextBlock x:Name="AnaliseVelocidadeText"
                                           Text="--"
                                           FontSize="22"
                                           FontWeight="Bold"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="Número de Reynolds"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="ReynoldsText"
                                           Text="--"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Regime de escoamento"
                                           Foreground="#64748B"
                                           Margin="0,12,0,2"/>

                                <TextBlock x:Name="RegimeText"
                                           Text="--"
                                           FontWeight="Bold"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="Fator de atrito"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="FatorAtritoText"
                                           Text="--"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <Separator Margin="0,10"/>

                                <TextBlock Text="Perda distribuída"
                                           Foreground="#64748B"/>

                                <TextBlock x:Name="PerdaDistribuidaText"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Perda localizada"
                                           Foreground="#64748B"
                                           Margin="0,10,0,2"/>

                                <TextBlock x:Name="PerdaLocalizadaText"
                                           Text="--"
                                           FontSize="18"
                                           FontWeight="Bold"/>

                                <Separator Margin="0,12"/>

                                <TextBlock Text="PERDA TOTAL"
                                           Foreground="#64748B"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="PerdaTotalText"
                                           Text="--"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           Foreground="#059669"/>

                                <TextBlock Text="Resultados em metros de coluna d'água (m.c.a.)."
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 3: REDE HIDRÁULICA (ETAPA 1: NÓS/RESERVATÓRIOS | ETAPA 2: TRECHOS) -->
            <TabItem Header="REDE HIDRÁULICA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12">

                        <!-- ETAPA 1: ELEMENTOS DA REDE (NÓS E RESERVATÓRIOS) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUNA ESQUERDA: FORMULÁRIO DE CADASTRO / EDIÇÃO DE NÓS -->
                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="24">
                                <StackPanel>
                                    <TextBlock Text="1. ELEMENTO DA REDE (NÓ / RESERVATÓRIO)"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#172554"/>

                                    <Border x:Name="NoModoEdicaoBadge"
                                            Background="#EFF6FF"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,12,0,0">
                                        <TextBlock x:Name="NoModoEdicaoText"
                                                   Text="Modo: Novo elemento"
                                                   Foreground="#1D4ED8"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="Tipo de elemento"
                                               Margin="0,16,0,6"
                                               FontWeight="SemiBold"/>

                                    <ComboBox x:Name="NoTipoComboBox"
                                              FontSize="15"
                                              Padding="10,8"
                                              SelectionChanged="NoTipoComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Reservatório"
                                                      Tag="Reservoir"
                                                      IsSelected="True"/>
                                        <ComboBoxItem Content="Nó de Distribuição"
                                                      Tag="Junction"/>
                                        <ComboBoxItem Content="Ponto de Consumo"
                                                      Tag="ConsumptionPoint"/>
                                    </ComboBox>

                                    <TextBlock Text="Nome / Identificação"
                                               Margin="0,14,0,6"
                                               FontWeight="SemiBold"/>

                                    <TextBox x:Name="NoNomeTextBox"
                                             FontSize="16"
                                             Padding="9"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cota / Elevação (m)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <TextBox x:Name="NoCotaTextBox"
                                                     Text="0,00"
                                                     FontSize="16"
                                                     Padding="9"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Demanda (L/s)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <TextBox x:Name="NoDemandaTextBox"
                                                     Text="0,00"
                                                     FontSize="16"
                                                     Padding="9"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock x:Name="NoAjudaTipoText"
                                               Text="Reservatório: define a cota piezométrica de origem da rede (demanda fixa em 0,00 L/s)."
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>

                                    <Button x:Name="SalvarNoButton"
                                            Content="ADICIONAR ELEMENTO"
                                            Click="SalvarNo_Click"
                                            Height="44"
                                            Margin="0,18,0,0"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                    <Button x:Name="CancelarEdicaoNoButton"
                                            Content="LIMPAR FORMULÁRIO"
                                            Click="CancelarEdicaoNo_Click"
                                            Height="38"
                                            Margin="0,10,0,0"
                                            Background="#E2E8F0"
                                            Foreground="#1E293B"
                                            FontWeight="SemiBold"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- COLUNA DIREITA: LISTA DE ELEMENTOS CADASTRADOS -->
                            <Border Grid.Column="2"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="ELEMENTOS CADASTRADOS NA REDE"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#172554"/>

                                    <TextBlock x:Name="ResumoRedeText"
                                               Grid.Row="1"
                                               Text="Nenhum elemento cadastrado | Demanda total: 0,000 L/s"
                                               Foreground="#64748B"
                                               FontSize="12"
                                               Margin="0,6,0,12"/>

                                    <DataGrid x:Name="NosDataGrid"
                                              Grid.Row="2"
                                              MinHeight="240"
                                              MaxHeight="330"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#E2E8F0"
                                              Background="White"
                                              BorderBrush="#CBD5E1"
                                              BorderThickness="1"
                                              RowHeight="32"
                                              FontSize="13"
                                              MouseDoubleClick="NosDataGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Nome"
                                                                Binding="{Binding Name}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Tipo"
                                                                Binding="{Binding TypeLabel}"
                                                                Width="150"/>
                                            <DataGridTextColumn Header="Cota (m)"
                                                                Binding="{Binding ElevationDisplay}"
                                                                Width="95"/>
                                            <DataGridTextColumn Header="Demanda (L/s)"
                                                                Binding="{Binding DemandDisplay}"
                                                                Width="115"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="3"
                                          Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="EditarNoButton"
                                                Grid.Column="0"
                                                Content="EDITAR ELEMENTO"
                                                Click="EditarNo_Click"
                                                Height="40"
                                                Background="#172554"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand"/>

                                        <Button x:Name="ExcluirNoButton"
                                                Grid.Column="2"
                                                Content="EXCLUIR ELEMENTO"
                                                Click="ExcluirNo_Click"
                                                Height="40"
                                                Background="#DC2626"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ETAPA 2: TRECHOS DE TUBULAÇÃO ENTRE NÓS -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COLUNA ESQUERDA: FORMULÁRIO DE CADASTRO / EDIÇÃO DE TRECHOS -->
                            <Border Grid.Column="0"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="24">
                                <StackPanel>
                                    <TextBlock Text="2. TRECHO DE TUBULAÇÃO"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#172554"/>

                                    <Border x:Name="TrechoModoEdicaoBadge"
                                            Background="#EFF6FF"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,12,0,0">
                                        <TextBlock x:Name="TrechoModoEdicaoText"
                                                   Text="Modo: Novo trecho"
                                                   Foreground="#1D4ED8"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </Border>

                                    <TextBlock Text="Nome / Identificação do trecho"
                                               Margin="0,16,0,6"
                                               FontWeight="SemiBold"/>

                                    <TextBox x:Name="TrechoNomeTextBox"
                                             FontSize="16"
                                             Padding="9"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Nó inicial (montante)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <ComboBox x:Name="TrechoNoInicialComboBox"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      FontSize="14"
                                                      Padding="9,8"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Nó final (jusante)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <ComboBox x:Name="TrechoNoFinalComboBox"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      FontSize="14"
                                                      Padding="9,8"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Comprimento (m)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoComprimentoTextBox"
                                                     Text="10,00"
                                                     FontSize="16"
                                                     Padding="9"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Diâmetro interno (mm)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoDiametroTextBox"
                                                     Text="21,60"
                                                     FontSize="16"
                                                     Padding="9"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Rugosidade abs. (mm)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoRugosidadeTextBox"
                                                     Text="0,001"
                                                     FontSize="16"
                                                     Padding="9"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Perda localizada (K)"
                                                       Margin="0,0,0,6"
                                                       FontWeight="SemiBold"/>
                                            <TextBox x:Name="TrechoCoeficienteKTextBox"
                                                     Text="0"
                                                     FontSize="16"
                                                     Padding="9"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Vazão do trecho (L/s) — opcional"
                                               Margin="0,14,0,6"
                                               FontWeight="SemiBold"/>

                                    <TextBox x:Name="TrechoVazaoTextBox"
                                             FontSize="16"
                                             Padding="9"/>

                                    <TextBlock Text="Deixe a vazão em branco para o cálculo automático a partir das demandas dos pontos de consumo na próxima etapa."
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>

                                    <Button x:Name="SalvarTrechoButton"
                                            Content="ADICIONAR TRECHO"
                                            Click="SalvarTrecho_Click"
                                            Height="44"
                                            Margin="0,18,0,0"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                    <Button x:Name="CancelarEdicaoTrechoButton"
                                            Content="LIMPAR FORMULÁRIO"
                                            Click="CancelarEdicaoTrecho_Click"
                                            Height="38"
                                            Margin="0,10,0,0"
                                            Background="#E2E8F0"
                                            Foreground="#1E293B"
                                            FontWeight="SemiBold"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- COLUNA DIREITA: LISTA DE TRECHOS CADASTRADOS -->
                            <Border Grid.Column="2"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="TRECHOS CADASTRADOS NA REDE"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="#172554"/>

                                    <TextBlock x:Name="ResumoTrechosText"
                                               Grid.Row="1"
                                               Text="Nenhum trecho cadastrado | Extensão total: 0,00 m"
                                               Foreground="#64748B"
                                               FontSize="12"
                                               Margin="0,6,0,12"/>

                                    <DataGrid x:Name="TrechosDataGrid"
                                              Grid.Row="2"
                                              MinHeight="280"
                                              MaxHeight="420"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              SelectionMode="Single"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#E2E8F0"
                                              Background="White"
                                              BorderBrush="#CBD5E1"
                                              BorderThickness="1"
                                              RowHeight="32"
                                              FontSize="13"
                                              MouseDoubleClick="TrechosDataGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Trecho"
                                                                Binding="{Binding Name}"
                                                                Width="95"/>
                                            <DataGridTextColumn Header="Montante → Jusante"
                                                                Binding="{Binding ConnectionDisplay}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Comp. (m)"
                                                                Binding="{Binding LengthDisplay}"
                                                                Width="85"/>
                                            <DataGridTextColumn Header="D int (mm)"
                                                                Binding="{Binding DiameterDisplay}"
                                                                Width="88"/>
                                            <DataGridTextColumn Header="K"
                                                                Binding="{Binding KDisplay}"
                                                                Width="58"/>
                                            <DataGridTextColumn Header="Vazão (L/s)"
                                                                Binding="{Binding FlowDisplay}"
                                                                Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="3"
                                          Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="EditarTrechoButton"
                                                Grid.Column="0"
                                                Content="EDITAR TRECHO"
                                                Click="EditarTrecho_Click"
                                                Height="40"
                                                Background="#172554"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand"/>

                                        <Button x:Name="ExcluirTrechoButton"
                                                Grid.Column="2"
                                                Content="EXCLUIR TRECHO"
                                                Click="ExcluirTrecho_Click"
                                                Height="40"
                                                Background="#DC2626"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <TextBlock Grid.Row="4"
                                               Text="Dica: cadastre pelo menos dois elementos acima para interligá-los. Nós conectados a trechos ficam protegidos contra exclusão acidental."
                                               Foreground="#64748B"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="BAHR HIDRO"
                   Foreground="#64748B"
                   FontSize="11"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>
                            <Button DockPanel.Dock="Right" Content="Próxima: Etapa 4 — Esgoto Sanitário →" Style="{StaticResource PrimaryButton}" Click="BtnIrEsgoto_Click"/>
                            <TextBlock Text="Etapa 3 de 5 • Água Quente &amp; Boiler (ABNT NBR 7198)" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1060" HorizontalAlignment="Left">

                                        <DataGridTextColumn Header="Trecho" Binding="{Binding Name}" Width="68"/>
                                        <DataGridTextColumn Header="Ligação" Binding="{Binding ConnectionDisplay}" Width="155"/>
                                        <DataGridTextColumn Header="Q (L/s)" Binding="{Binding FlowDisplay}" Width="62"/>
                                        <DataGridTextColumn Header="Ø Antigo" Binding="{Binding OriginalDiameterDisplay}" Width="72"/>
                                        <DataGridTextColumn Header="Ø Novo" Binding="{Binding DiameterDisplay}" Width="72"/>

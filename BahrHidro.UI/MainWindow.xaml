<Window x:Class="BahrHidro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BahrHidro.UI"
        Title="Bahr Hidro - Engenharia Hidráulica e BIM"
        Height="780" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BhBgCanvas" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BhAccent" Color="#0284C7"/>
        <SolidColorBrush x:Key="BhBorderSubtle" Color="#CBD5E1"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickChipButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="RevitActionButton" BasedOn="{StaticResource PrimaryButton}"/>

        <Style TargetType="Button" x:Key="RevitApplyButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#15803D"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E8F0"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="#F1F5F9">
        <!-- Barra Superior Limpa e Objetiva -->
        <Border x:Name="TopQuickShortcutBar" DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="38" Height="36" Margin="0,0,11,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#0369A1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="BH" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                            <Canvas Width="22" Height="10" HorizontalAlignment="Center">
                                <Line X1="1" Y1="5" X2="6" Y2="5" Stroke="#BAE6FD" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="16" Y1="5" X2="21" Y2="5" Stroke="#BAE6FD" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M 11,0.5 C 11,0.5 14.2,4.2 14.2,6.2 A 3.2,3.2 0 1 1 7.8,6.2 C 7.8,4.2 11,0.5 11,0.5 Z" Fill="#E0F2FE"/>
                            </Canvas>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="BAHR HIDRO" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <Border Background="#E0F2FE" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ActiveStepBadgeText" Text="Visão Geral do Fluxo" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Copiloto de Engenharia Hidrossanitária • ABNT NBR 5626 / 7198 / 8160 / 10844" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnVoltarAba" Style="{StaticResource QuickChipButton}" ToolTip="Voltar para a etapa anterior (Alt + ←)" Click="BtnVoltarAba_Click">
                        <TextBlock Text="← Voltar" Foreground="#0F172A"/>
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Click="BtnIrInicio_Click">
                        <TextBlock Text="🏠 Início" Foreground="#0F172A"/>
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Click="AbrirCatalogo_Click">
                        <TextBlock Text="📏 Catálogo de Tubos" Foreground="#0284C7"/>
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Click="NavConfiguracoes_Click">
                        <TextBlock Text="⚙ Parâmetros" Foreground="#334155"/>
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Margin="0" ToolTip="Ver atalhos de teclado (F1)" Click="MostrarGuiaAtalhos_Click">
                        <TextBlock Text="⌨ Atalhos [F1]" Foreground="#475569"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel>
        <!-- NAVEGADOR LATERAL LIMPO -->
        <Border DockPanel.Dock="Left" Width="244" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                    <TextBlock Text="ETAPAS DO PROJETO" FontSize="10.5" FontWeight="Bold" Foreground="#64748B"/>
                </Border>

                                                <TreeView x:Name="NavegadorTree" BorderThickness="0" Background="Transparent" Padding="10,4" SelectedItemChanged="NavegadorTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E8F0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                    </TreeView.Resources>

                    <TreeViewItem x:Name="NavInicio" Header="Início / Visão Geral" Tag="Inicio" IsSelected="True" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>

                    <TreeViewItem Header="DIMENSIONAMENTO ABNT" IsExpanded="True" FontSize="10.5" FontWeight="Bold" Foreground="#64748B">
                        <TreeViewItem x:Name="NavReservatorios" Header="1. Reservatórios" Tag="Reservatorios" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavAguaFria" Header="2. Água Fria" Tag="AguaFria" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavBomba" Header="    ↳ Pressurização / Bomba" Tag="Bomba" FontWeight="Normal" Foreground="#475569"/>
                        <TreeViewItem x:Name="NavAguaQuente" Header="3. Água Quente (Boiler)" Tag="AguaQuente" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavEsgoto" Header="4. Esgoto Sanitário" Tag="Esgoto" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavPluvial" Header="5. Calhas &amp; Pluvial" Tag="Pluvial" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </TreeViewItem>

                    <TreeViewItem Header="DOCUMENTAÇÃO FINAL" IsExpanded="True" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,10,0,0">
                        <TreeViewItem x:Name="NavVistas3DVivas" Header="Pranchas &amp; Vistas 3D ABNT" Tag="Vistas3DVivas" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TreeViewItem x:Name="NavMemorial" Header="Gerar Memoriais &amp; SINAPI" Tag="Memorial" FontWeight="SemiBold" Foreground="#1E293B"/>
                    </TreeViewItem>

                    <TreeViewItem Header="FERRAMENTAS FUTURAS (API)" IsExpanded="False" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,10,0,0">
                        <TreeViewItem x:Name="NavTracado3D" Header="Traçado Automático (Futuro API)" Tag="Tracado3D" FontWeight="Normal" Foreground="#64748B"/>
                    </TreeViewItem>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ÁREA PRINCIPAL DE CONTEÚDO -->
        <Border Margin="12" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
            <Grid>
                <!-- 0. TELA INICIAL / VISÃO GERAL -->
                <ScrollViewer x:Name="PanelInicio" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel MaxWidth="1060" HorizontalAlignment="Left">
                        <Border Background="#0F172A" CornerRadius="10" Padding="22" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FLUXO GUIADO DE PROJETO COMPLEMENTAR" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Dimensionamento, Auditoria Normativa e Memoriais" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="InicioProjetoStatusText" Text="Modele o traçado básico no Revit e avance pelas 5 etapas abaixo. Os dados calculados em uma etapa alimentam automaticamente as seguintes." Foreground="#CBD5E1" FontSize="12.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Button Content="Iniciar pela Etapa 1 →" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" Click="BtnIrReservatorios_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                                                <!-- Linha 1: Etapas 1, 2 e 3 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="ETAPA 1" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                                        </Border>
                                        <TextBlock Text="Reservatórios" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Detecta caixas no 3D, verifica pressão da rua e calcula volumes comerciais (Superior e Cisterna)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="48"/>
                                    <Button Content="Abrir Reservatórios" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrReservatorios_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="ETAPA 2" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                                        </Border>
                                        <TextBlock Text="Água Fria &amp; Bomba" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="InicioRedeStatusText" Text="Audita o traçado do Revit, dimensiona bitolas por ΣP, verifica pressões/velocidades e pressurizador." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="48"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Abrir Água Fria" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrAguaFria_Click"/>
                                        <Button x:Name="BtnImportarInicioRevit" Grid.Column="1" Content="Ler 3D" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="8,0,0,0" Click="DetectarRedeAutoRevit_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="ETAPA 3" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                                        </Border>
                                        <TextBlock Text="Água Quente &amp; Boiler" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Dimensiona o volume do Boiler, regime de trabalho (Alta/Baixa Pressão) e potência térmica." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="48"/>
                                    <Button Content="Abrir Água Quente" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrAguaQuente_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Linha 2: Etapas 4, 5 e Entrega de Memoriais -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="ETAPA 4" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                                        </Border>
                                        <TextBlock Text="Esgoto Sanitário" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Contagem de aparelhos por UHC, diâmetro mínimo do coletor e declividades normativas (NBR 8160)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="48"/>
                                    <Button Content="Abrir Esgoto Sanitário" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrEsgoto_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="ETAPA 5" FontSize="10.5" FontWeight="Bold" Foreground="#334155"/>
                                        </Border>
                                        <TextBlock Text="Calhas &amp; Pluvial" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Lê coberturas do Revit, aplica chuva regional e dimensiona calhas e condutores verticais." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="48"/>
                                    <Button Content="Abrir Calhas &amp; Pluvial" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrPluvial_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="ENTREGA" FontSize="10.5" FontWeight="Bold" Foreground="#166534"/>
                                        </Border>
                                        <TextBlock Text="Memoriais &amp; BOM" FontSize="14" FontWeight="Bold" Foreground="#14532D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="InicioCatalogoStatusText" Text="Gera planilha Excel + BOM, Memorial Descritivo, Cálculo Analítico e PDF Unificado." FontSize="12" Foreground="#166534" TextWrapping="Wrap" Height="48"/>
                                    <Button Content="Gerar Todos os Memoriais →" Style="{StaticResource RevitApplyButton}" HorizontalAlignment="Stretch" Click="BtnIrMemorial_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>



                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Ferramentas BIM 3D:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Style="{StaticResource QuickChipButton}" Click="QuickRibbonCache_Click">
                                        <TextBlock Text="⚡ Atualizar Cache LSF [F5]"/>
                                    </Button>
                                    <Button Style="{StaticResource QuickChipButton}" Click="QuickRibbonAudit_Click">
                                        <TextBlock Text="🎨 Auditoria Visual 3D [Ctrl+Shift+A]"/>
                                    </Button>
                                    <Button Style="{StaticResource QuickChipButton}" Click="QuickRibbonLsf_Click">
                                        <TextBlock Text="🔩 Validar Furos LSF [Ctrl+Shift+L]"/>
                                    </Button>
                                    <Button Style="{StaticResource QuickChipButton}" Margin="0" Click="QuickRibbonSheets_Click">
                                        <TextBlock Text="📐 Gerar Pranchas [Ctrl+Shift+P]"/>
                                    </Button>
                                    <Button x:Name="NavConfiguracoesBtn" Visibility="Collapsed" Click="NavConfiguracoes_Click"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 0C. VISTAS 3D AO VIVO, SEÇÃO GERAL &amp; ORDEM AF -> AQ -> ESGOTO -->
                <DockPanel x:Name="PanelVistas3DVivas" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pranchas Executivas ABNT &amp; Isométricos 3D Cotados" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Geração automática de vistas isométricas 3D bloqueadas por ambiente molhado, etiquetas e prancha executiva (HID-01)." FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="← Etapa 5: Calhas &amp; Pluvial" Style="{StaticResource SecondaryButton}" Click="BtnIrPluvial_Click"/>
                            <Button DockPanel.Dock="Right" Content="Avançar para Memoriais &amp; Orçamento SINAPI →" Style="{StaticResource PrimaryButton}" Click="BtnIrMemorial_Click"/>
                            <TextBlock Text="Documentação Executiva BIM 3D • ABNT NBR 5626 / 8160" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1080" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="GERADOR AUTOMÁTICO DE VISTAS E PRANCHAS" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                                    <CheckBox x:Name="ChkGerarIsometricos3D" Content="Gerar Vistas Isométricas 3D recortadas e bloqueadas por ambiente molhado (Escala 1:25)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkMontarPranchaAbnt" Content="Montar Prancha Executiva ABNT (HID-01) com Planta, Isométricos 3D e Esquema Vertical" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                    <WrapPanel Margin="0,0,0,14">
                                        <Button Content="Gerar Isométricos 3D &amp; Prancha ABNT" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="GerarDocumentacao3DAbnt_Click"/>
                                        <Button Content="Gerar Esquema Vertical de Prumadas" Style="{StaticResource SecondaryButton}" Click="GerarEsquemaVertical_Click"/>
                                    </WrapPanel>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <TextBlock x:Name="Doc3DStatusText" Text="Pronto para gerar vistas isométricas 3D com etiquetas e montar a prancha executiva no Navegador de Projetos do Revit." FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="O QUE É CRIADO AUTOMATICAMENTE NO REVIT" FontSize="11.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#334155" LineHeight="19"
                                               Text="1. Vistas Isométricas 3D por Ambiente: Detecta banheiros, cozinhas e áreas de serviço, aplica Section Box ajustado, bloqueia a orientação 3D e insere etiquetas de diâmetro.&#x0a;2. Esquema Vertical de Prumadas: Diagrama esquemático pavimento a pavimento com bitolas de AF, AQ, TQ e CV (Escala 1:50).&#x0a;3. Prancha Executiva (HID-01): Agrupa planta baixa, isométricos 3D e esquema vertical prontos para plotagem."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 0B. TRAÇADO AUTOMÁTICO 3D (ROTEAMENTO BIM IFC/DWG) -->
                <DockPanel x:Name="PanelTracado3D" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsTracado3D" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="1. Detectar Pontos (IFC / DWG)" Style="{StaticResource RevitActionButton}" Margin="0,0,8,0" Click="DetectarPontosTracado_Click"/>
                                <Button Content="2. Gerar Traçado Automático no 3D" Style="{StaticResource RevitApplyButton}" Click="ExecutarTracado3D_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Traçado Automático de Tubulações 3D (IFC, DWG &amp; Revit)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Detecta louças e metais em vínculos IFC, blocos DWG ou cliques manuais e traça a rede completa no 3D." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1160" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.95*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Coluna Esquerda: Configurações e Clique Manual -->
                            <StackPanel Grid.Column="0">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="1. Disciplina, Plano e Proteção Steel Frame" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                                        <TextBlock Text="Sistema a Traçar no 3D" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TracadoDisciplinaComboBox" SelectedIndex="0" Margin="0,0,0,10" Padding="6" SelectionChanged="TracadoDisciplinaComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Água Fria (ABNT NBR 5626 — Alimentação + Ramais)" Tag="ColdWater"/>
                                            <ComboBoxItem Content="Água Quente (ABNT NBR 7198 — Afastado 15 cm da Água Fria)" Tag="HotWater"/>
                                            <ComboBoxItem Content="Esgoto Sanitário (ABNT NBR 8160 — Caixa Sifonada + Dimensionamento UHC)" Tag="SanitarySewer"/>
                                            <ComboBoxItem Content="Ventilação Sanitária (ABNT NBR 8160 — Colunas DN 50 mm)" Tag="Ventilation"/>
                                            <ComboBoxItem Content="Águas Pluviais (ABNT NBR 10844 — Condutores Verticais do Telhado)" Tag="StormDrainage"/>
                                        </ComboBox>

                                        <TextBlock Text="Direção do Traçado Principal" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TracadoPlanoComboBox" SelectedIndex="0" Margin="0,0,0,10" Padding="6" SelectionChanged="TracadoPlanoComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Por Cima (Entreforro / Laje — descendo até os pontos)" Tag="Top"/>
                                            <ComboBoxItem Content="Por Baixo (Piso / Contrapiso — subindo até os pontos)" Tag="Bottom"/>
                                        </ComboBox>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nível de Referência (Pavimento)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="TracadoNivelComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Cota Relativa ao Nível (m)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TracadoOffsetTextBox" Text="2,60"/>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="ChkDesviarSteelFrame" IsChecked="True" Margin="0,0,0,6"
                                                  Content="Guiar pelas paredes + desviar de perfis Steel Frame e vãos de portas/janelas"
                                                  FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                                        <CheckBox x:Name="ChkInserirRegistrosAuto" IsChecked="True"
                                                  Content="Inserir Registos de Pressão (chuveiros) e Gaveta (manutenção) automaticamente"
                                                  FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="2. Padrões do Template Revit" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                                        <TextBlock Text="Sistema de Tubulação (Piping System Type)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TracadoSystemTypeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10" Padding="6"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tipo de Tubo (Pipe Type)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="TracadoPipeTypeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Bitola Inicial (mm)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="TracadoDiametroComboBox" SelectedIndex="1" Padding="6">
                                                    <ComboBoxItem Content="20 mm (1/2&quot;)" Tag="20"/>
                                                    <ComboBoxItem Content="25 mm (3/4&quot;)" Tag="25"/>
                                                    <ComboBoxItem Content="32 mm (1&quot;)" Tag="32"/>
                                                    <ComboBoxItem Content="40 mm (1 1/4&quot;)" Tag="40"/>
                                                    <ComboBoxItem Content="50 mm (1 1/2&quot;)" Tag="50"/>
                                                    <ComboBoxItem Content="75 mm (3&quot;)" Tag="75"/>
                                                    <ComboBoxItem Content="100 mm (4&quot;)" Tag="100"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Inserção Manual Rápida para DWG sem blocos -->
                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="3. Marcação Rápida no DWG / 3D (Opcional)" FontSize="13" FontWeight="Bold" Foreground="#78350F" Margin="0,0,0,4"/>
                                        <TextBlock Text="Se o DWG veio apenas com linhas soltas (sem blocos), escolha o aparelho e clique na planta:" FontSize="12" Foreground="#92400E" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="TracadoPontoManualTipoComboBox" Grid.Column="0" Height="32" SelectedIndex="0">
                                                <ComboBoxItem Content="Vaso Sanitário (H = 0,20 m | ΣP = 0,3)" Tag="Vaso Sanitário"/>
                                                <ComboBoxItem Content="Lavatório / Cuba (H = 0,60 m | ΣP = 0,3)" Tag="Lavatório"/>
                                                <ComboBoxItem Content="Chuveiro / Ducha (H = 2,10 m | ΣP = 0,4)" Tag="Chuveiro"/>
                                                <ComboBoxItem Content="Pia de Cozinha (H = 0,60 m | ΣP = 0,7)" Tag="Pia de Cozinha"/>
                                                <ComboBoxItem Content="Tanque (H = 0,90 m | ΣP = 0,7)" Tag="Tanque"/>
                                                <ComboBoxItem Content="Máquina de Lavar (H = 0,90 m | ΣP = 1,0)" Tag="Máquina de Lavar"/>
                                            </ComboBox>

                                            <Button Grid.Column="2" Content="+ Clicar no DWG/3D" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Click="AdicionarPontoManualDwg_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Coluna Direita: Lista de Pontos Detectados + Geração -->
                            <StackPanel Grid.Column="2">
                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Detectar (IFC / DWG)" Style="{StaticResource RevitActionButton}" Height="30" Padding="10,0" Margin="0,0,6,0" Click="DetectarPontosTracado_Click"/>
                                                <Button Content="Limpar Lista" Style="{StaticResource SecondaryButton}" Height="30" Padding="10,0" Click="LimparPontosTracado_Click"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Pontos de Consumo Detectados (IFC / DWG / Revit)" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock x:Name="TracadoTemplateStatusText" Text="Clique em 'Detectar (IFC / DWG)' para ler louças e metais da arquitetura." FontSize="11" Foreground="#64748B"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <DataGrid x:Name="TracadoPontosDataGrid" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="Usar" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                                <DataGridTextColumn Header="Ponto / Aparelho" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Origem" Binding="{Binding SourceType}" IsReadOnly="True" Width="70"/>
                                                <DataGridTextColumn Header="Posição" Binding="{Binding CoordinatesDisplay}" IsReadOnly="True" Width="110"/>
                                                <DataGridTextColumn Header="Altura H (m)" Binding="{Binding PointHeightMeters, StringFormat=N2}" Width="80"/>
                                                <DataGridTextColumn Header="Peso ΣP" Binding="{Binding Weight, StringFormat=N2}" Width="65"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="Gerar Traçado Automático no 3D" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="ExecutarTracado3D_Click"/>
                                            <Button Content="Limpar Traçado (Disciplina)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="LimparTracadoDisciplina_Click"/>
                                            <Button Content="Interligar Prumadas Multinível" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="GerarPrumadasMultinivel_Click"/>
                                            <Button Content="Ir para Água Fria (Dimensionar)" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="BtnIrAguaFria_Click"/>
                                        </WrapPanel>

                                        <TextBlock x:Name="TracadoResumoGeracaoText" Text="Resultado: Aguardando geração do traçado." FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,6"/>
                                        <TextBox x:Name="TracadoLogTextBox" Height="95" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#F8FAFC" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Documentação Automática BIM, Clash Check e Pranchas -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="4. Documentação Automática, Clash Check 3D e Pranchas" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,4"/>
                                        <TextBlock Text="Audita interferências contra o Steel Frame, gera vistas isométricas 3D (1:25 c/ Tags) e monta as pranchas de plotagem." FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Content="1. Verificar Colisões (Steel Frame)" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,6,6" Click="VerificarColisoesSteelFrame_Click"/>
                                            <Button Content="2. Gerar Isométricos 3D (c/ Tags)" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,6,6" Click="GerarIsometricos3D_Click"/>
                                            <Button Content="3. Elevações de Parede (1:20)" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,6,6" Click="GerarElevacoesParede_Click"/>
                                            <Button Content="4. Gerar Pranchas (Plotagem)" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,6,6" Click="GerarPranchasPlotagem_Click"/>
                                            <Button Content="Taggear Vista Atual" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,0,6" Click="TaggearTubosVistaAtual_Click"/>
                                            <Button Content="Auditar Furação LSF" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="6,0,6,6" Click="AuditarFuracaoLsf_Click"/>
                                            <Button Content="Cotas Fabricação X/H (1:20)" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="0,0,0,6" Click="CotasFabricacaoElevacoes_Click"/>
                                            <Button Content="Atualizar Cache LSF" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="6,0,0,6" Click="AtualizarCacheLsf_Click"/>
                                            <Button Content="Limpar Rede Gerada" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Margin="6,0,0,6" Click="LimparRedeGerada_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 1. ÁGUA FRIA (REDE BIM 3D - SOMENTE LEITURA AUTOMÁTICA) -->
                <DockPanel x:Name="PanelAguaFria" Visibility="Collapsed">
                    <!-- Cabeçalho Padronizado do Módulo -->
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel x:Name="HeaderActionsAguaFria" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Button Content="Detectar Rede (3D)" Style="{StaticResource RevitActionButton}" Margin="0,0,6,0" Click="DetectarRedeAutoRevit_Click"/>
                                    <Button Content="Apontar Início no 3D" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ImportarRevit_Click"/>
                                    <Button Content="Aplicar Diâmetros no Revit" Style="{StaticResource RevitApplyButton}" Margin="0,0,6,0" Click="AplicarRevit_Click"/>
                                    <Button Content="Esquema Vertical" Style="{StaticResource SecondaryButton}" Click="GerarEsquemaVertical_Click"/>
                                    <Button x:Name="BtnPintarAuditoria3D" Content="Pintar 3D" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Visibility="Collapsed" Click="PintarAuditoria3D_Click"/>
                                    <Button x:Name="BtnLimparAuditoria3D" Content="Limpar Cores" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Visibility="Collapsed" Click="LimparAuditoria3D_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="2. Rede de Água Fria — Dimensionamento Hidráulico (NBR 5626)" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="Alimentação da rua até o reservatório e rede interna de distribuição por gravidade." FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Barra de Sub-rede e Origem (Gravidade vs Entrada da Rua) -->
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Sub-rede / Trecho:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="SubRedeComboBox" Width="340" Margin="0,0,14,0" SelectionChanged="SubRedeComboBox_SelectionChanged"/>
                                <TextBlock Text="Pressão da Rua / Entrada (m.c.a.):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="PressaoRuaAguaFriaTextBox" Text="15,0" Width="68" Margin="0,0,8,0"/>
                                <Button Content="Recarregar Sub-rede" Style="{StaticResource SecondaryButton}" Height="32" Padding="10,0" Click="RecarregarSubRede_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="← Etapa 1: Reservatórios" Style="{StaticResource SecondaryButton}" Click="BtnIrReservatorios_Click"/>
                            <Button DockPanel.Dock="Right" Content="Próxima: Etapa 3 — Água Quente (Boiler) →" Style="{StaticResource PrimaryButton}" Click="BtnIrAguaQuente_Click"/>
                            <TextBlock Text="Etapa 2 de 5 • Rede de Água Fria (ABNT NBR 5626)" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <StackPanel>
                            <!-- TABELAS DE LEITURA DO MODELO 3D -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PAINEL ESQUERDO: NÓS E RESERVATÓRIOS -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="ResumoRedeText" DockPanel.Dock="Right" Text="0 elementos" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                            <TextBlock Text="1. Nós e Reservatórios Lidos do Modelo 3D" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                        </DockPanel>

                                        <DataGrid x:Name="NosDataGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Identificação" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="Tipo" Binding="{Binding TypeLabel}" Width="100"/>
                                                <DataGridTextColumn Header="Cota (m)" Binding="{Binding ElevationDisplay}" Width="75"/>
                                                <DataGridTextColumn Header="Vazão (L/s)" Binding="{Binding DemandDisplay}" Width="80"/>
                                                <DataGridTextColumn Header="Peso (ΣP)" Binding="{Binding WeightDisplay}" Width="75"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- PAINEL DIREITO: TRECHOS DE TUBULAÇÃO -->
                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock x:Name="ResumoTrechosText" DockPanel.Dock="Right" Text="0 trecho(s)" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                                            <TextBlock Text="2. Trechos de Tubulação Lidos do Modelo 3D" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                        </DockPanel>

                                        <DataGrid x:Name="TrechosDataGrid" Height="230" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Trecho" Binding="{Binding Name}" Width="85"/>
                                                <DataGridTextColumn Header="Ligação (Montante → Jusante)" Binding="{Binding ConnectionDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="Comp. (m)" Binding="{Binding LengthDisplay}" Width="75"/>
                                                <DataGridTextColumn Header="Ø (mm)" Binding="{Binding DiameterDisplay}" Width="65"/>
                                                <DataGridTextColumn Header="K" Binding="{Binding KDisplay}" Width="55"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- BARRA DE CÁLCULO HIDRÁULICO -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Viscosidade Cinemática (m²/s):" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="RedeViscosidadeTextBox" Width="130" Text="0,000001003" Margin="0,0,16,0"/>
                                        <Button Content="Calcular Rede Hidráulica" Style="{StaticResource PrimaryButton}" Click="CalcularRede_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusCalculoAguaFriaText" DockPanel.Dock="Right" Text="Importe a rede 3D do Revit e clique em Calcular." Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- RESUMO DE ALTERAÇÕES E AUDITORIA DE TUBULAÇÕES -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <DockPanel>
                                    <CheckBox x:Name="ChkSomenteTrocados" DockPanel.Dock="Right" Content="Mostrar apenas tubos trocados"
                                              FontSize="12" FontWeight="SemiBold" Foreground="#1E3A8A" VerticalAlignment="Center"

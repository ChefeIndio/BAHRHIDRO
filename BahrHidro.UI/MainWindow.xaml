<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:BahrHidro.UI" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BahrHidro.UI.MainWindow" Title="Smart Hidro - Engenharia Hidráulica e BIM • " WindowStartupLocation="CenterScreen" Background="#F1F5F9" FontFamily="Segoe UI" ResizeMode="CanResize" MinHeight="460" WindowState="Maximized" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BhBgCanvas" Color="#F1F5F9" />
        <SolidColorBrush x:Key="BhAccent" Color="#F28C38" />
        <SolidColorBrush x:Key="BhBorderSubtle" Color="#CBD5E1" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F28C38" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#FFFFFF" CornerRadius="4" Padding="3,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Image Source="/BahrHidro.UI;component/LogoSmart.png" Height="24" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D97724" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B85D14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/BahrHidro.UI;component/LogoSmart.png" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F28C38" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickChipButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF3E8" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F28C38" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE2C7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="RevitActionButton" BasedOn="{StaticResource PrimaryButton}" />

        <Style TargetType="Button" x:Key="RevitApplyButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#15803D" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E8F0" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
            </Style.Resources>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Background="#F1F5F9" VerticalAlignment="Stretch">
        
        <Border x:Name="TopQuickShortcutBar" DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Height="46" MinWidth="126" Margin="0,0,14,0" VerticalAlignment="Center" Background="#FFFFFF" BorderBrush="#F28C38" BorderThickness="1.5" Padding="3">
                        <Image Source="/BahrHidro.UI;component/LogoSmart.png" Height="38" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SMART HIDRO" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                            <Border Background="#FFF3E8" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ActiveStepBadgeText" Text="Visão Geral do Fluxo" FontSize="11" FontWeight="SemiBold" Foreground="#D97724" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Copiloto de Engenharia Hidrossanitária • ABNT NBR 5626 / 7198 / 8160 / 10844 • By Frederico Bahr" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnVoltarAba" Style="{StaticResource QuickChipButton}" ToolTip="Voltar para a etapa anterior (Alt + ←)" Click="BtnVoltarAba_Click">
                        <TextBlock Text="← Voltar" Foreground="#0F172A" />
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Click="BtnIrInicio_Click">
                        <TextBlock Text="🏠 Início" Foreground="#0F172A" />
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Click="AbrirCatalogo_Click">
                        <TextBlock Text="📏 Catálogo de Tubos" Foreground="#F28C38" />
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Click="NavConfiguracoes_Click">
                        <TextBlock Text="⚙ Parâmetros" Foreground="#334155" />
                    </Button>
                    <Button Style="{StaticResource QuickChipButton}" Margin="0" ToolTip="Ver atalhos de teclado (F1)" Click="MostrarGuiaAtalhos_Click">
                        <TextBlock Text="⌨ Atalhos [F1]" Foreground="#475569" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel VerticalAlignment="Stretch">
        
        <Border DockPanel.Dock="Left" Width="244" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                    <TextBlock Text="ETAPAS DO PROJETO" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                </Border>

                                                <TreeView x:Name="NavegadorTree" BorderThickness="0" Background="Transparent" Padding="6,6,6,12" SelectedItemChanged="NavegadorTree_SelectedItemChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E8F0" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                    </TreeView.Resources>

                    <TreeViewItem x:Name="NavInicio" Header="Início / Visão Geral" Tag="Inicio" IsSelected="True" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8" />

                    <TreeViewItem Header="DIMENSIONAMENTO ABNT" IsExpanded="True" FontSize="10.5" FontWeight="Bold" Foreground="#64748B">
                        <TreeViewItem x:Name="NavReservatorios" Header="1. Reservatórios" Tag="Reservatorios" FontWeight="SemiBold" Foreground="#1E293B" />
                        <TreeViewItem x:Name="NavAguaFria" Header="2. Água Fria" Tag="AguaFria" FontWeight="SemiBold" Foreground="#1E293B" />
                        <TreeViewItem x:Name="NavBomba" Header="    ↳ Pressurização / Bomba" Tag="Bomba" FontWeight="Normal" Foreground="#475569" />
                        <TreeViewItem x:Name="NavAguaQuente" Header="3. Água Quente (Boiler)" Tag="AguaQuente" FontWeight="SemiBold" Foreground="#1E293B" />
                        <TreeViewItem x:Name="NavEsgoto" Header="4. Esgoto Sanitário" Tag="Esgoto" FontWeight="SemiBold" Foreground="#1E293B" />
                        <TreeViewItem x:Name="NavPluvial" Header="5. Calhas &amp; Pluvial" Tag="Pluvial" FontWeight="SemiBold" Foreground="#1E293B" />
                    </TreeViewItem>

                    <TreeViewItem Header="DOCUMENTAÇÃO FINAL" IsExpanded="True" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,10,0,0">
                        <TreeViewItem x:Name="NavClash3D" Header="Compatibilização 3D (Clash)" Tag="Clash3D" FontWeight="SemiBold" Foreground="#1E293B" /><TreeViewItem x:Name="NavVistas3DVivas" Header="Pranchas &amp; Isométricos 2D/3D ABNT" Tag="Vistas3DVivas" FontWeight="SemiBold" Foreground="#1E293B" />
                        <TreeViewItem x:Name="NavMemorial" Header="Gerar Memoriais &amp; SINAPI" Tag="Memorial" FontWeight="SemiBold" Foreground="#1E293B" />
                    </TreeViewItem>

                    <TreeViewItem Header="FERRAMENTAS FUTURAS (API)" IsExpanded="False" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,10,0,0">
                        <TreeViewItem x:Name="NavTracado3D" Header="Traçado Automático (Futuro API)" Tag="Tracado3D" FontWeight="Normal" Foreground="#64748B" />
                    </TreeViewItem>
                </TreeView>
            </DockPanel>
        </Border>

        
        <Border Margin="12" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                
                <ScrollViewer x:Name="MainPagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0,0,10,24"><StackPanel VerticalAlignment="Top"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,24" Visibility="{Binding Visibility, ElementName=PanelInicio}" VerticalAlignment="Top" Margin="0,0,0,28"><ScrollViewer x:Name="PanelInicio" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="24" Margin="0,0,0,24" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                                <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                                    <!-- HERO BANNER COM AUTORIA -->
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Background="#F28C38" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                                        <TextBlock Text="FLUXO GUIADO DE PROJETO BIM" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" />
                                                    </Border>
                                                    <Border Background="#1E293B" BorderBrush="#F28C38" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                                        <TextBlock Text="PRODUCED BY FREDERICO BAHR" Foreground="#FDBA74" FontSize="10.5" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="Smart Hidro — Dimensionamento &amp; Auditoria Normativa" Foreground="#FFFFFF" FontSize="21" FontWeight="Bold" Margin="0,0,0,8" />

                                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,12,0">
                                                    <TextBlock x:Name="InicioProjetoStatusText" Text="Modele o traçado básico no Revit e avance pelas 5 etapas abaixo. Os dados calculados em uma etapa alimentam automaticamente as seguintes." Foreground="#E2E8F0" FontSize="12.5" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                                                <Button Content="Iniciar pela Etapa 1 →" Style="{StaticResource PrimaryButton}" Height="42" Padding="20,0" Click="BtnIrReservatorios_Click" />
                                                <TextBlock Text="Engineered by Frederico Bahr" Foreground="#94A3B8" FontSize="11" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- LINHA 1: ETAPAS 1 A 3 -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="NBR 5626" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#FFF3E8" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                            <TextBlock Text="ETAPA 01" FontSize="10.5" FontWeight="Bold" Foreground="#C26619" />
                                                        </Border>
                                                        <TextBlock Text="Reservatórios" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="Detecta caixas no 3D, verifica pressão da rua e calcula volumes comerciais (Superior e Cisterna)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                                                <Button Content="Abrir Reservatórios" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrReservatorios_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="NBR 5626" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#FFF3E8" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                            <TextBlock Text="ETAPA 02" FontSize="10.5" FontWeight="Bold" Foreground="#C26619" />
                                                        </Border>
                                                        <TextBlock Text="Água Fria &amp; Bomba" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock x:Name="InicioRedeStatusText" Text="Audita o traçado do Revit, dimensiona bitolas por ΣP, verifica pressões/velocidades e pressurizador." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="Abrir Água Fria" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrAguaFria_Click" />
                                                    <Button x:Name="BtnImportarInicioRevit" Grid.Column="1" Content="Ler 3D" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="8,0,0,0" Click="DetectarRedeAutoRevit_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="NBR 7198" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#FFF3E8" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                            <TextBlock Text="ETAPA 03" FontSize="10.5" FontWeight="Bold" Foreground="#C26619" />
                                                        </Border>
                                                        <TextBlock Text="Água Quente &amp; Boiler" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="Dimensiona o volume do Boiler, regime de trabalho (Alta/Baixa Pressão) e potência térmica." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                                                <Button Content="Abrir Água Quente" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrAguaQuente_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- LINHA 2: ETAPAS 4, 5 E ENTREGA -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="NBR 8160" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#FFF3E8" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                            <TextBlock Text="ETAPA 04" FontSize="10.5" FontWeight="Bold" Foreground="#C26619" />
                                                        </Border>
                                                        <TextBlock Text="Esgoto Sanitário" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="Contagem de aparelhos por UHC, diâmetro mínimo do coletor e declividades normativas (NBR 8160)." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                                                <Button Content="Abrir Esgoto Sanitário" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrEsgoto_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="NBR 10844" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#FFF3E8" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                            <TextBlock Text="ETAPA 05" FontSize="10.5" FontWeight="Bold" Foreground="#C26619" />
                                                        </Border>
                                                        <TextBlock Text="Calhas &amp; Pluvial" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="Lê coberturas do Revit, aplica chuva regional e dimensiona calhas e condutores verticais." FontSize="12" Foreground="#475569" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                                                <Button Content="Abrir Calhas &amp; Pluvial" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="BtnIrPluvial_Click" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="18">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="FINAL" FontSize="10.5" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                            <TextBlock Text="ENTREGA" FontSize="10.5" FontWeight="Bold" Foreground="#166534" />
                                                        </Border>
                                                        <TextBlock Text="Memoriais &amp; BOM" FontSize="14.5" FontWeight="Bold" Foreground="#14532D" VerticalAlignment="Center" />

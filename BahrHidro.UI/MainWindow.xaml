                                    <TextBox x:Name="CfgVelMaxBox" Height="28" Padding="6,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Pressão Mín. Dinâmica (m.c.a.)" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgPressaoMinBox" Height="28" Padding="6,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Vara Comercial Tubo (m)" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox x:Name="CfgVaraTuboBox" Height="28" Padding="6,3" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Salvar Padrão do Escritório" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0" Margin="0,0,8,6" Click="SalvarConfiguracoes_Click" />
                        <Button Content="Exportar Perfil (.json)" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,6" Click="ExportarPerfilJson_Click" />
                        <Button Content="Importar Perfil (.json)" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,6" Click="ImportarPerfilJson_Click" />
                        <Button Content="Restaurar Padrão NBR" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="0,0,8,6" Click="RestaurarPadraoNbr_Click" />
                    </WrapPanel>

                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock Text="4. Atualizações do Plugin (GitHub - ChefeIndio/BAHRHIDRO)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="UpdateStatusText" Text="Clique em 'Verificar Atualizações' para consultar a versão mais recente." FontSize="12" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Verificar Atualizações (GitHub)" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,4" Click="VerificarAtualizacoes_Click" />
                                <Button Content="Atualizar Plugin no Windows" Style="{StaticResource PrimaryButton}" Height="32" Padding="12,0" Margin="0,0,8,4" Click="ExecutarAtualizadorWindows_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock Text="5. Licença &amp; Chave de Segurança" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock x:Name="LicenseInfoText" Text="Verificando licença..." FontSize="12" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="Gerenciar / Alterar Chave de Segurança" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0" HorizontalAlignment="Left" Click="GerenciarLicenca_Click" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="CfgStatusText" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            </ScrollViewer><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,24" Visibility="{Binding Visibility, ElementName=PageClash3D}" VerticalAlignment="Top" Margin="0,0,0,28"><DockPanel x:Name="PageClash3D" Visibility="Collapsed" Margin="0,0,0,24" VerticalAlignment="Stretch">
                                <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Compatibilização 3D (Clash LSF / Estrutura) &amp; Mapa Visual" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                                        <TextBlock Text="Auditoria real de interferências entre tubulações e estrutura/LSF e mapa colorido 3D de pressão e velocidade." FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="← Etapa 5: Calhas &amp; Pluvial" Style="{StaticResource SecondaryButton}" Click="BtnIrPluvial_Click" />
                                        <Button DockPanel.Dock="Right" Content="Avançar para Pranchas &amp; Isométricos →" Style="{StaticResource PrimaryButton}" Click="BtnIrMemorial_Click" />
                                        <TextBlock Text="Compatibilização BIM 3D • Detecção de Furos em Vigas, Lajes e Perfis LSF" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18" VerticalAlignment="Stretch">
                                    <Border MaxWidth="1080" HorizontalAlignment="Left" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16" VerticalAlignment="Top">
                                        <StackPanel>
                                            <TextBlock Text="COMPATIBILIZAÇÃO 3D (CLASH LSF / ESTRUTURA) &amp; MAPA VISUAL HIDRÁULICO 3D" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                                            <TextBlock Text="Audita interferências reais entre tubulações e vigas, pilares, lajes ou perfis LSF (host e vínculos) e colore os tubos no 3D por faixa de pressão e velocidade." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12" />

                                            <WrapPanel Margin="0,0,0,12">
                                                <Button Content="Auditar Clash 3D (Estrutura &amp; LSF)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="ExecutarClash3D_Click" />
                                                <Button Content="Exportar Relatório de Furos (.csv)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="ExportarRelatorioFurosCsv_Click" />
                                                <Button Content="Gerar Mapa Visual 3D (Pressão &amp; Velocidade)" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" Click="GerarMapaDiagnostico3D_Click" />
                                            </WrapPanel>

                                            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <TextBlock x:Name="ClashAndDiagStatusText" Text="Execute a auditoria 3D para detectar conflitos estruturais/LSF ou gerar a vista 3D colorida de diagnóstico hidráulico." FontSize="11.5" FontWeight="SemiBold" Foreground="#9A3412" TextWrapping="Wrap" />
                                            </Border>

                                            <DataGrid x:Name="ClashResultsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" RowHeight="28" MaxHeight="230" FontSize="11.5" VerticalScrollBarVisibility="Auto">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34" />
                                                    <DataGridTextColumn Header="Sistema" Binding="{Binding PipeSystem}" Width="110" />
                                                    <DataGridTextColumn Header="DN (mm)" Binding="{Binding DiameterMm}" Width="66" />
                                                    <DataGridTextColumn Header="Elemento Estrutural / LSF" Binding="{Binding StructuralCategory}" Width="145" />
                                                    <DataGridTextColumn Header="Modelo" Binding="{Binding SourceModel}" Width="110" />
                                                    <DataGridTextColumn Header="Cota Z (m)" Binding="{Binding ElevationMeters, StringFormat=N2}" Width="74" />
                                                    <DataGridTextColumn Header="Furo Sugerido" Binding="{Binding RecommendedSleeve}" Width="*" />
                                                    <DataGridTemplateColumn Header="Ação 3D" Width="92">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Ver no 3D" Style="{StaticResource SecondaryButton}" Height="24" Padding="6,0" FontSize="11" Tag="{Binding PipeElementId}" Click="ZoomClashElemento3D_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </DockPanel></ScrollViewer></StackPanel></ScrollViewer></Grid>
        </Border>
    </DockPanel>
    </DockPanel>
</Window>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Perfil da Edificação" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="BoilerPerfilComboBox" SelectedIndex="0" Margin="0,0,0,12" Padding="6"/>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Número de Ocupantes / Pessoas" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="BoilerOcupantesTextBox" Text="5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Pressão de Trabalho (m.c.a.)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <TextBox x:Name="BoilerPressaoTextBox" Text="4,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Dimensionar Boiler" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CalcularBoiler_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="32"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Consumo Diário Estimado:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BoilerConsumoText" Text="--"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume de Acumulação:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BoilerVolumeText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Modelo Comercial Sugerido:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BoilerComercialText" Text="--" FontWeight="Bold" Foreground="#0F172A"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Classificação de Pressão:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BoilerTipoText" Text="--" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Sugestões Comerciais e Peças Obrigatórias (Boiler) -->
                            <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="SUGESTÕES COMERCIAIS &amp; PEÇAS OBRIGATÓRIAS (ÁGUA QUENTE)" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="BoilerSugestoesText" TextWrapping="Wrap" FontSize="13" Foreground="#14532D" LineHeight="20"
                                               Text="• Marcas e Linhas de Referência: Komeco (KSS / Inox), Bosch / Heliotek (MK / HP), Soletrol ou Cumulus (tanque interno em Aço Inox 304 ou 316L).&#x0a;&#x0a;• Tubulação Recomendada: PPR PN 20 / PN 25 (termofusão) ou CPVC Aquatherm (soldável), com isolamento térmico nos trechos embutidos em Steel Frame.&#x0a;&#x0a;• Peças Obrigatórias no Projeto (NBR 7198):&#x0a;  1. Válvula de segurança e alívio (pressão/temperatura) na saída de água quente;&#x0a;  2. Tubo de respiro (suspiro) acima do nível máximo da caixa d'água fria (para baixa pressão) ou válvula eliminadora de ar (alta pressão);&#x0a;  3. Válvula de retenção na entrada de alimentação de água fria;&#x0a;  4. Registros de esfera/gaveta na entrada, saída e dreno de limpeza."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 3. RESERVATÓRIOS -->
                <DockPanel x:Name="PanelReservatorios" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsReservatorios" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Detectar Reservatório &amp; Rua (3D)" Style="{StaticResource RevitActionButton}" Margin="0,0,8,0" Click="DetectarReservatoriosRevit_Click"/>

                                            <DataGridTextColumn Header="C. Piez." Binding="{Binding HeadDisplay}" Width="70"/>
                                            <DataGridTextColumn Header="Pressão (mca)" Binding="{Binding PressureDisplay}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 1B. PRESSURIZAÇÃO / BOMBA (ABA DEDICADA) -->
                <DockPanel x:Name="PanelBomba" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pressurização &amp; Dimensionamento de Bomba (NBR 5626)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Verificação automática de pressão dinâmica mínima nos pontos de consumo e dimensionamento do conjunto motobomba." FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="← Voltar para Água Fria" Style="{StaticResource SecondaryButton}" Click="BtnIrAguaFria_Click"/>
                            <Button DockPanel.Dock="Right" Content="Próxima: Etapa 3 — Água Quente (Boiler) →" Style="{StaticResource PrimaryButton}" Click="BtnIrAguaQuente_Click"/>
                            <TextBlock Text="Sub-etapa 2B • Pressurização / Motobomba" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
                        <Grid MaxWidth="1040" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                                                        <!-- Diagnóstico e Dimensionamento Direto (NBR 5626) -->
                            <Border Grid.Column="0" x:Name="BombaStatusCard" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="Recalcular" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Click="RecalcularBomba_Click"/>
                                        <TextBlock Text="Diagnóstico e Dimensionamento" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock x:Name="BombaDiagnosticoText" Text="Calcule a rede de Água Fria para verificar automaticamente a necessidade de pressurização." FontWeight="Bold" FontSize="13" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="28"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ponto Crítico (Mais Desfavorável):" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BombaNoCriticoText" Text="--"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pressão Atual no Ponto Crítico:" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BombaPressaoAtualText" Text="--"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Vazão de Projeto (Q):" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BombaVazaoText" Text="--"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Altura Manométrica (AMT):" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BombaAmtText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Potência Comercial Estimada:" FontWeight="Bold"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BombaPotenciaText" Text="--" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </Grid>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10">
                                        <TextBlock FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="17"
                                                   Text="Critério Normativo Automático (ABNT NBR 5626): Pressão dinâmica mínima de 1,00 m.c.a. (10 kPa) e rendimento padrão do conjunto de 60%. Ao atender o ponto crítico (aparelho mais alto/distante com menor pressão), todo o restante do sistema é atendido automaticamente."/>
                                    </Border>
                                </StackPanel>
                            </Border>



                            <!-- Sugestões Comerciais e Peças Obrigatórias -->
                            <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="SUGESTÕES COMERCIAIS &amp; PEÇAS OBRIGATÓRIAS" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="BombaSugestoesText" TextWrapping="Wrap" FontSize="13" Foreground="#14532D" LineHeight="20"
                                               Text="• Equipamento Recomendado: Pressurizador silencioso com inversor de frequência ou fluxostato automático (ex.: Grundfos Scala2 / CMB, Komeco TP40/TP80, Rowa Tango/Press).&#x0a;&#x0a;• Peças Obrigatórias no Barrilete (NBR 5626):&#x0a;  1. Válvula de retenção horizontal/vertical na sucção e no recalque;&#x0a;  2. Registros de esfera/gaveta antes e depois da bomba para manutenção;&#x0a;  3. By-pass com válvula de retenção para abastecimento por gravidade em falta de energia;&#x0a;  4. Manômetro com registro na saída do recalque;&#x0a;  5. Uniões e juntas flexíveis antivibração (essencial em estruturas Light Steel Framing)."/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- 2. ÁGUA QUENTE (BOILER) -->
                <DockPanel x:Name="PanelAguaQuente" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                        <DockPanel>
                            <StackPanel x:Name="HeaderActionsAguaQuente" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button Content="Ler Ocupantes do Revit" Style="{StaticResource RevitActionButton}" Click="EstimarPopulacaoRevit_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dimensionamento de Reservatório Térmico (Boiler)" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Cálculo de acumulação de água quente (NBR 7198 / NBR 5626), classificação de pressão e especificação de componentes." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
                        <DockPanel>

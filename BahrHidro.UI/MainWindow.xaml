                                        <TextBlock Text="RELATÓRIO DE SUBSTITUIÇÃO E DIMENSIONAMENTO DOS TUBOS" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,2"/>
                                        <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PARECER TÉCNICO &amp; AUDITORIA NORMATIVA (NBR 5626 + COMPATIBILIZAÇÃO LSF)" FontSize="11.5" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ParecerTecnicoAguaFriaText" Text="Importe o traçado básico do Revit e clique em 'Calcular Rede Hidráulica' para receber o diagnóstico de pressões, velocidades, bitolas e compatibilização LSF." FontSize="12" Foreground="#78350F" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ResumoTrocasTubosText" Text="Calcule a rede para visualizar quais tubos foram alterados, o motivo técnico e o impacto hidráulico." FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </DockPanel>
